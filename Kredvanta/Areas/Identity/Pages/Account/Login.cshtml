@page
@model Kredvanta.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Welcome Back";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | Kings Microfinance</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
            :root {
                --primary: #166534;
                --primary-dark: #14532d;
                --text: #202b25;
                --muted: #718078;
                --border: #e2ebe4;
                --background: #f3f8f4;
            }

            * {
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                margin: 0;
                font-family: 'Segoe UI', Arial, sans-serif;
                color: var(--text);
                background: radial-gradient(circle at 10% 10%, #dcfce7 0, transparent 32%), radial-gradient(circle at 90% 90%, #e8f5eb 0, transparent 32%), var(--background);
            }

            .page-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 35px 18px;
            }

            .login-card {
                width: 100%;
                max-width: 1050px;
                min-height: 620px;
                display: grid;
                grid-template-columns: 1fr 1fr;
                background: #fff;
                border-radius: 24px;
                overflow: hidden;
                box-shadow: 0 25px 80px rgba(40, 45, 100, 0.12);
            }

            /* BRAND PANEL */

            .brand-panel {
                position: relative;
                overflow: hidden;
                padding: 50px;
                color: #fff;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                background: linear-gradient(145deg, #14532d, #166534 55%, #22c55e);
            }

                .brand-panel::before,
                .brand-panel::after {
                    content: "";
                    position: absolute;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.08);
                    pointer-events: none;
                }

                .brand-panel::before {
                    width: 360px;
                    height: 360px;
                    right: -150px;
                    top: -100px;
                }

                .brand-panel::after {
                    width: 300px;
                    height: 300px;
                    left: -140px;
                    bottom: -120px;
                }

            .brand,
            .brand-content,
            .brand-footer {
                position: relative;
                z-index: 1;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 25px;
                font-weight: 800;
                letter-spacing: 0.3px;
            }

            .brand-logo {
                display: block;
                width: 132px;
                height: 111px;
                object-fit: contain;
                border-radius: 8px;
                background: #f7f7f2;
            }

            .brand-content {
                margin-top: 65px;
                margin-bottom: 55px;
            }

            .brand-tag {
                display: inline-block;
                padding: 8px 13px;
                border: 1px solid rgba(255,255,255,.25);
                border-radius: 30px;
                background: rgba(255,255,255,.12);
                color: #fff;
                font-size: 12px;
                font-weight: 600;
                margin-bottom: 25px;
            }

            .brand-content h1 {
                font-size: 38px;
                line-height: 1.2;
                font-weight: 750;
                letter-spacing: -1px;
                margin-bottom: 20px;
            }

            .brand-content p {
                color: rgba(255,255,255,.82);
                font-size: 15px;
                line-height: 1.8;
                max-width: 390px;
            }

            .brand-features {
                margin-top: 35px;
            }

            .brand-feature {
                display: flex;
                align-items: center;
                gap: 13px;
                margin-bottom: 18px;
                color: rgba(255,255,255,.92);
                font-size: 14px;
            }

                .brand-feature i {
                    width: 34px;
                    height: 34px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 10px;
                    background: rgba(255,255,255,.15);
                    font-size: 17px;
                }

            .brand-footer {
                color: rgba(255,255,255,.65);
                font-size: 12px;
            }

            /* LOGIN PANEL */

            .form-panel {
                padding: 60px 65px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .form-heading {
                margin-bottom: 35px;
            }

                .form-heading .welcome-icon {
                    width: 48px;
                    height: 48px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 14px;
                    background: #efefff;
                    color: var(--primary);
                    font-size: 23px;
                    margin-bottom: 22px;
                }

                .form-heading h2 {
                    font-size: 30px;
                    font-weight: 750;
                    letter-spacing: -0.7px;
                    margin-bottom: 9px;
                }

                .form-heading p {
                    color: var(--muted);
                    font-size: 14px;
                    margin-bottom: 0;
                }

            .form-label {
                color: #41465c;
                font-size: 13px;
                font-weight: 650;
                margin-bottom: 9px;
            }

            .form-control {
                height: 53px;
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 12px 15px;
                font-size: 14px;
                color: var(--text);
                background: #fff;
            }

                .form-control::placeholder {
                    color: #b0b4c5;
                }

                .form-control:focus {
                        border-color: var(--primary);
                        box-shadow: 0 0 0 4px rgba(34,197,94,.14);
                }

            .input-group .form-control {
                border-radius: 10px 0 0 10px;
            }

            .password-toggle {
                min-width: 50px;
                border: 1px solid var(--border);
                border-left: 0;
                border-radius: 0 10px 10px 0;
                background: #fff;
                color: #858ba3;
            }

                .password-toggle:hover {
                    color: var(--primary);
                }

            .form-check-input {
                cursor: pointer;
            }

                .form-check-input:checked {
                    background-color: var(--primary);
                    border-color: var(--primary);
                }

            .form-check-label {
                color: var(--muted);
                font-size: 13px;
                cursor: pointer;
            }

            .forgot-link {
                color: var(--primary);
                font-size: 13px;
                font-weight: 650;
                text-decoration: none;
            }

                .forgot-link:hover {
                    color: var(--primary-dark);
                    text-decoration: underline;
                }

            .btn-login {
                width: 100%;
                height: 53px;
                border: 0;
                border-radius: 10px;
                background: linear-gradient(100deg, #166534, #22c55e);
                color: #fff;
                font-size: 14px;
                font-weight: 700;
                box-shadow: 0 8px 20px rgba(22,101,52,.24);
                transition: .2s ease;
            }

                .btn-login:hover {
                    color: #fff;
                    background: linear-gradient(100deg, #14532d, #166534);
                    transform: translateY(-2px);
                    box-shadow: 0 11px 25px rgba(22,101,52,.30);
                }

            .divider {
                display: flex;
                align-items: center;
                gap: 14px;
                margin: 27px 0;
                color: #a0a5b7;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: .6px;
            }

                .divider::before,
                .divider::after {
                    content: "";
                    height: 1px;
                    flex: 1;
                    background: var(--border);
                }

            .google-btn {
                width: 100%;
                height: 51px;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 12px;
                border: 1px solid var(--border);
                border-radius: 10px;
                background: #fff;
                color: #41465c;
                font-size: 14px;
                font-weight: 650;
                transition: .2s ease;
            }

                .google-btn:hover {
                    background: #f9f9ff;
                    border-color: #c9c8ed;
                }

            .google-icon {
                width: 19px;
                height: 19px;
            }

            .register-link {
                margin-top: 30px;
                text-align: center;
                color: var(--muted);
                font-size: 13px;
            }

                .register-link a {
                    color: var(--primary);
                    font-weight: 700;
                    text-decoration: none;
                    margin-left: 3px;
                }

                    .register-link a:hover {
                        text-decoration: underline;
                    }

            .validation-summary-errors {
                padding: 12px 15px;
                margin-bottom: 20px;
                border: 1px solid #ffcaca;
                border-radius: 9px;
                background: #fff3f3;
                color: #b42318;
                font-size: 13px;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 18px;
                }

            .text-danger {
                display: block;
                margin-top: 5px;
                font-size: 12px;
            }

            /* RESPONSIVE */

            @@media (max-width: 850px) {
                .login-card {
                    max-width: 550px;
                    grid-template-columns: 1fr;
                }

                .brand-panel {
                    padding: 35px;
                }

                .brand-content {
                    margin: 40px 0 15px;
                }

                    .brand-content h1 {
                        font-size: 30px;
                    }

                .brand-features,
                .brand-footer {
                    display: none;
                }

                .form-panel {
                    padding: 40px 35px;
                }
            }

            @@media (max-width: 480px) {
                .page-wrapper {
                    padding: 15px;
                }

                .login-card {
                    border-radius: 18px;
                }

                .brand-panel {
                    padding: 25px;
                }

                .brand-content h1 {
                    font-size: 27px;
                }

                .form-panel {
                    padding: 30px 24px;
                }

                .form-heading h2 {
                    font-size: 26px;
                }
            }
    </style>
</head>

<body>

    <div class="page-wrapper">

        <div class="login-card">

            <!-- BRAND PANEL -->

            <div class="brand-panel">

                <div class="brand">
                    <img class="brand-logo" src="@Url.Content("~/images/kings-microfinance-logo.jpg")" alt="Kings Microfinance" />
                </div>

                <div class="brand-content">

                    <div class="brand-tag">
                        <i class="bi bi-stars me-1"></i>
                        YOUR FINANCIAL JOURNEY STARTS HERE
                    </div>

                    <h1>Welcome to a smarter way to access finance.</h1>

                    <p>
                        Take control of your financial journey with a simple,
                        secure platform designed to make borrowing easier.
                    </p>

                    <div class="brand-features">

                        <div class="brand-feature">
                            <i class="bi bi-shield-lock"></i>
                            Secure account management
                        </div>

                        <div class="brand-feature">
                            <i class="bi bi-wallet2"></i>
                            Explore available loan products
                        </div>

                        <div class="brand-feature">
                            <i class="bi bi-graph-up-arrow"></i>
                            Monitor your loan applications
                        </div>

                    </div>

                </div>

                <div class="brand-footer">
                    &copy; @DateTime.Now.Year Kings Microfinance. All rights reserved.
                </div>

            </div>


            <!-- LOGIN FORM -->

            <div class="form-panel">

                <div class="form-heading">

                    <div class="welcome-icon">
                        <i class="bi bi-person-lock"></i>
                    </div>

                    <h2>Welcome back!</h2>

                    <p>Enter your account details to sign in.</p>

                </div>


                <form id="account" method="post" asp-page="./Login">

                    <input type="hidden"
                           name="returnUrl"
                           value="@Model.ReturnUrl" />


                    <!-- EMAIL -->

                    <div class="mb-4">

                        <label asp-for="Input.Email" class="form-label">
                            Email address
                        </label>

                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />

                        <span asp-validation-for="Input.Email"
                              class="text-danger"></span>

                    </div>


                    <!-- PASSWORD -->

                    <div class="mb-3">

                        <label asp-for="Input.Password" class="form-label">
                            Password
                        </label>

                        <div class="input-group">

                            <input asp-for="Input.Password"
                                   id="loginPassword"
                                   class="form-control"
                                   autocomplete="current-password"
                                   aria-required="true"
                                   placeholder="Enter your password" />

                            <button type="button"
                                    class="password-toggle"
                                    id="togglePassword"
                                    aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger"></span>

                    </div>


                    <!-- REMEMBER ME / FORGOT PASSWORD -->

                    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">

                        <div class="form-check">

                            <input asp-for="Input.RememberMe"
                                   class="form-check-input" />

                            <label asp-for="Input.RememberMe"
                                   class="form-check-label">
                                Remember me
                            </label>

                        </div>

                        <a asp-page="./ForgotPassword"
                           class="forgot-link">
                            Forgot password?
                        </a>

                    </div>


                    <!-- SIGN IN -->

                    <button id="login-submit"
                            type="submit"
                            class="btn btn-login">

                        Sign in
                        <i class="bi bi-arrow-right ms-2"></i>

                    </button>

                </form>


                <!-- GOOGLE LOGIN -->
                @if (Model.ExternalLogins?.Any(x => x.Name == "Google") == true)
                {
                    <div class="divider">
                        OR CONTINUE WITH
                    </div>

                    <form id="external-account"
                          asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post">

                        <button type="submit"
                                class="google-btn"
                                name="provider"
                                value="Google">

                            <svg class="google-icon"
                                 viewBox="0 0 48 48"
                                 xmlns="http://www.w3.org/2000/svg">

                                <path fill="#EA4335"
                                      d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />

                                <path fill="#4285F4"
                                      d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.76 7.18l7.73 6C44.42 37.99 46.98 31.88 46.98 24.55z" />

                                <path fill="#FBBC05"
                                      d="M10.53 28.59A14.4 14.4 0 0 1 9.5 24c0-1.59.27-3.12.76-4.59l-7.98-6.19A23.9 23.9 0 0 0 0 24c0 3.87.93 7.52 2.56 10.78l7.97-6.19z" />

                                <path fill="#34A853"
                                      d="M24 48c6.48 0 11.93-2.13 15.91-5.8l-7.73-6c-2.14 1.45-4.89 2.3-8.18 2.3-6.26 0-11.57-4.22-13.46-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />

                            </svg>

                            Continue with Google

                        </button>

                    </form>
                }


                <!-- REGISTER -->

                <div class="register-link">

                    Don't have an account?

                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        Create an account
                    </a>

                </div>

            </div>

        </div>

    </div>


    <script>
            const togglePassword = document.getElementById("togglePassword");
            const passwordInput = document.getElementById("loginPassword");

            if (togglePassword && passwordInput) {
                togglePassword.addEventListener("click", function () {

                    const isPassword = passwordInput.type === "password";

                    passwordInput.type = isPassword ? "text" : "password";

                    this.innerHTML = isPassword
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';

                    this.setAttribute(
                        "aria-label",
                        isPassword ? "Hide password" : "Show password"
                    );
                });
            }
    </script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>
