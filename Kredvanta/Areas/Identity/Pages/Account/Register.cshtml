@page
@model Kredvanta.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Create Account";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kings Microfinance | Create Account</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
            :root {
                --navy: #123b2a;
                --navy-light: #1d5138;
                --orange: #22c55e;
                --background: #f3f8f4;
                --muted: #718096;
                --border: #e3e8f0;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: var(--background);
                font-family: "Segoe UI", Arial, sans-serif;
                color: var(--navy);
            }

            .page-wrapper {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 35px 18px;
            }

            .register-card {
                width: 100%;
                max-width: 1120px;
                background: #fff;
                border-radius: 22px;
                overflow: hidden;
                box-shadow: 0 20px 65px rgba(16, 29, 54, .10);
            }

            .brand-panel {
                position: relative;
                height: 100%;
                min-height: 760px;
                padding: 48px 42px;
                color: white;
                background: radial-gradient(circle at 10% 90%, rgba(34,197,94,.20), transparent 32%), linear-gradient(145deg, #123b2a, #1d5138);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                overflow: hidden;
            }

                .brand-panel::after {
                    content: "";
                    position: absolute;
                    width: 260px;
                    height: 260px;
                    right: -110px;
                    top: 100px;
                    border: 1px solid rgba(255,255,255,.10);
                    border-radius: 50%;
                    box-shadow: 0 0 0 35px rgba(255,255,255,.025), 0 0 0 70px rgba(255,255,255,.02);
                }

            .brand-content, .brand-footer {
                position: relative;
                z-index: 1;
            }

            .brand-logo {
                display: flex;
                align-items: center;
                gap: 12px;
                color: white;
                text-decoration: none;
                font-size: 25px;
                font-weight: 800;
                letter-spacing: -.7px;
            }

            .brand-logo img {
                display: block;
                width: 118px;
                height: 99px;
                object-fit: contain;
                border-radius: 8px;
                background: #f7f7f2;
            }

            .brand-heading {
                margin-top: 75px;
                font-size: clamp(32px, 3vw, 43px);
                line-height: 1.18;
                font-weight: 800;
                letter-spacing: -1.2px;
            }

                .brand-heading span {
                    color: #ffad62;
                }

            .brand-description {
                max-width: 390px;
                margin-top: 18px;
                color: rgba(255,255,255,.72);
                line-height: 1.8;
                font-size: 15px;
            }

            .benefit-list {
                margin-top: 42px;
                display: grid;
                gap: 23px;
            }

            .benefit {
                display: flex;
                align-items: flex-start;
                gap: 15px;
            }

            .benefit-icon {
                width: 42px;
                height: 42px;
                flex-shrink: 0;
                display: grid;
                place-items: center;
                border-radius: 12px;
                background: rgba(255,255,255,.11);
                color: #ffad62;
                font-size: 19px;
            }

            .benefit strong {
                display: block;
                margin-bottom: 4px;
            }

            .benefit small {
                color: rgba(255,255,255,.65);
                line-height: 1.5;
            }

            .brand-footer {
                color: rgba(255,255,255,.55);
                font-size: 12px;
            }

            .form-panel {
                padding: 43px 48px;
            }

            .mobile-brand {
                display: none;
                margin-bottom: 30px;
            }

            .form-heading {
                font-size: 29px;
                font-weight: 800;
                letter-spacing: -.8px;
            }

            .form-subtitle {
                color: var(--muted);
                font-size: 14px;
            }

            .section-label {
                font-size: 12px;
                font-weight: 700;
                color: #8a96a8;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin: 25px 0 13px;
            }

            .field-label {
                font-size: 13px;
                font-weight: 650;
                margin-bottom: 7px;
                color: #34435b;
            }

            .input-group-custom {
                position: relative;
            }

                .input-group-custom > i {
                    position: absolute;
                    top: 50%;
                    left: 14px;
                    transform: translateY(-50%);
                    color: #8491a5;
                    z-index: 3;
                }

                .input-group-custom .form-control {
                    height: 47px;
                    padding: 10px 42px;
                    border: 1px solid var(--border);
                    border-radius: 9px !important;
                    font-size: 13px;
                    background: #fff;
                }

                    .input-group-custom .form-control:focus {
                        border-color: var(--orange);
                        box-shadow: 0 0 0 3px rgba(34,197,94,.14);
                    }

            .password-toggle {
                position: absolute;
                right: 13px;
                top: 50%;
                transform: translateY(-50%);
                z-index: 4;
                border: 0;
                background: transparent;
                color: #8491a5;
                padding: 4px;
            }

            .form-check-input:checked {
                background-color: var(--orange);
                border-color: var(--orange);
            }

            .form-check-input:focus {
                border-color: var(--orange);
                box-shadow: 0 0 0 3px rgba(34,197,94,.14);
            }

            .btn-register {
                height: 49px;
                background: var(--navy);
                color: white;
                border: 0;
                border-radius: 9px;
                font-weight: 700;
                transition: .2s ease;
            }

                .btn-register:hover {
                    background: var(--navy-light);
                    color: white;
                    transform: translateY(-1px);
                }

            .google-btn {
                height: 48px;
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                background: #fff;
                color: #344054;
                border: 1px solid var(--border);
                border-radius: 9px;
                font-size: 14px;
                font-weight: 650;
                transition: .2s ease;
            }

                .google-btn:hover {
                    background: #f9fafb;
                    border-color: #b8c2d1;
                }

            .google-icon {
                width: 19px;
                height: 19px;
            }

            .divider {
                display: flex;
                align-items: center;
                gap: 14px;
                margin: 22px 0;
                color: #9aa4b2;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
            }

                .divider::before, .divider::after {
                    content: "";
                    height: 1px;
                    flex: 1;
                    background: var(--border);
                }

            .validation-summary-valid {
                display: none;
            }

            .validation-summary-errors {
                padding: 12px 15px;
                margin-bottom: 18px;
                border-radius: 8px;
                background: #fff1f0;
                color: #b42318;
                font-size: 13px;
            }

            .field-validation-error {
                display: block;
                margin-top: 5px;
                font-size: 11px;
            }

            .signin-link {
                color: var(--orange);
                font-weight: 700;
                text-decoration: none;
            }

                .signin-link:hover {
                    color: #d9690c;
                }

            .terms-text {
                font-size: 12px;
                color: var(--muted);
            }

            @@media (max-width: 767px) {
                .page-wrapper {
                    padding: 15px 10px;
                }

                .brand-panel {
                    display: none;
                }

                .form-panel {
                    padding: 30px 23px;
                }

                .mobile-brand {
                    display: block;
                }

                .form-heading {
                    font-size: 25px;
                }
            }

            @@media (min-width: 768px) and (max-width: 991px) {
                .form-panel {
                    padding: 35px 28px;
                }

                .brand-panel {
                    padding: 40px 28px;
                }
            }
    </style>
</head>

<body>
    <main class="page-wrapper">
        <div class="register-card">
            <div class="row g-0">

                <!-- LEFT BRAND PANEL -->
                <div class="col-md-5">
                    <section class="brand-panel">
                        <div class="brand-content">
                            <a asp-area="" asp-controller="Home" asp-action="Index"
                               class="brand-logo">
                                <img src="@Url.Content("~/images/kings-microfinance-logo.jpg")" alt="Kings Microfinance home" />
                            </a>

                            <h1 class="brand-heading">
                                Your financial journey
                                <span>starts here.</span>
                            </h1>

                            <p class="brand-description">
                                Create your Kings Microfinance account and access a
                                simpler way to explore digital lending services.
                            </p>

                            <div class="benefit-list">
                                <div class="benefit">
                                    <span class="benefit-icon">
                                        <i class="bi bi-shield-check"></i>
                                    </span>
                                    <div>
                                        <strong>Secure account</strong>
                                        <small>Your account and personal information are handled securely.</small>
                                    </div>
                                </div>

                                <div class="benefit">
                                    <span class="benefit-icon">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </span>
                                    <div>
                                        <strong>Simple applications</strong>
                                        <small>Explore loan products and submit applications online.</small>
                                    </div>
                                </div>

                                <div class="benefit">
                                    <span class="benefit-icon">
                                        <i class="bi bi-graph-up-arrow"></i>
                                    </span>
                                    <div>
                                        <strong>Track your progress</strong>
                                        <small>Follow your application journey from your account.</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="brand-footer">
                            &copy; @DateTime.Now.Year Kings Microfinance. All rights reserved.
                        </div>
                    </section>
                </div>

                <!-- RIGHT REGISTRATION PANEL -->
                <div class="col-md-7">
                    <section class="form-panel">

                        <div class="mobile-brand">
                            <a asp-area="" asp-controller="Home" asp-action="Index"
                               class="brand-logo" style="color: var(--navy);">
                                <img src="@Url.Content("~/images/kings-microfinance-logo.jpg")" alt="Kings Microfinance home" />
                            </a>
                        </div>

                        <h2 class="form-heading mb-2">Create your account</h2>
                        <p class="form-subtitle mb-4">
                            Join Kings Microfinance and get started in a few simple steps.
                        </p>

                        <div class="divider">REGISTER WITH EMAIL</div>

                        <form method="post">
                            <div asp-validation-summary="ModelOnly" role="alert"></div>

                            <div class="section-label">Personal information</div>

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label asp-for="Input.FirstName" class="field-label"></label>
                                    <div class="input-group-custom">
                                        <i class="bi bi-person"></i>
                                        <input asp-for="Input.FirstName" class="form-control"
                                               placeholder="First name" autocomplete="given-name" />
                                    </div>
                                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="Input.LastName" class="field-label"></label>
                                    <div class="input-group-custom">
                                        <i class="bi bi-person"></i>
                                        <input asp-for="Input.LastName" class="form-control"
                                               placeholder="Last name" autocomplete="family-name" />
                                    </div>
                                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="section-label">Account details</div>

                            <div class="mb-3">
                                <label asp-for="Input.PhoneNumber" class="field-label"></label>
                                <div class="input-group-custom">
                                    <i class="bi bi-telephone"></i>
                                    <input asp-for="Input.PhoneNumber" class="form-control"
                                           placeholder="e.g. 0712345678" autocomplete="tel" />
                                </div>
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Email" class="field-label"></label>
                                <div class="input-group-custom">
                                    <i class="bi bi-envelope"></i>
                                    <input asp-for="Input.Email" class="form-control"
                                           placeholder="name@example.com" autocomplete="email" />
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label asp-for="Input.Password" class="field-label"></label>
                                    <div class="input-group-custom">
                                        <i class="bi bi-lock"></i>
                                        <input asp-for="Input.Password" class="form-control"
                                               placeholder="Create password" autocomplete="new-password"
                                               id="registerPassword" />
                                        <button type="button" class="password-toggle"
                                                onclick="togglePassword('registerPassword', this)"
                                                aria-label="Show password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>

                                <div class="col-sm-6">
                                    <label asp-for="Input.ConfirmPassword" class="field-label"></label>
                                    <div class="input-group-custom">
                                        <i class="bi bi-lock-fill"></i>
                                        <input asp-for="Input.ConfirmPassword" class="form-control"
                                               placeholder="Confirm password" autocomplete="new-password"
                                               id="confirmPassword" />
                                        <button type="button" class="password-toggle"
                                                onclick="togglePassword('confirmPassword', this)"
                                                aria-label="Show password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-check mt-4 mb-3">
                                <input asp-for="Input.AcceptTerms" class="form-check-input" />
                                <label asp-for="Input.AcceptTerms" class="form-check-label terms-text">
                                    I agree to the Terms and Conditions.
                                </label>
                                <span asp-validation-for="Input.AcceptTerms"
                                      class="text-danger d-block"></span>
                            </div>

                            <button type="submit" class="btn btn-register w-100">
                                Create account
                                <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </form>

                        <div class="text-center mt-4">
                            <span class="form-subtitle">Already have an account?</span>
                            <a asp-page="./Login" class="signin-link ms-1">Sign in</a>
                        </div>

                        <div class="text-center mt-4">
                            <a asp-area="" asp-controller="Home" asp-action="Index"
                               class="text-decoration-none small text-secondary">
                                <i class="bi bi-arrow-left me-1"></i>
                                Back to Kings Microfinance home
                            </a>
                        </div>

                    </section>
                </div>
            </div>
        </div>
    </main>

    <partial name="_ValidationScriptsPartial" />

    <script>
            function togglePassword(inputId, button) {
                const input = document.getElementById(inputId);
                const icon = button.querySelector("i");

                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.replace("bi-eye", "bi-eye-slash");
                    button.setAttribute("aria-label", "Hide password");
                } else {
                    input.type = "password";
                    icon.classList.replace("bi-eye-slash", "bi-eye");
                    button.setAttribute("aria-label", "Show password");
                }
            }
    </script>
</body>
</html>
