@using Microsoft.AspNetCore.Identity
@using Kredvanta.Models.Identity


@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Kredvanta Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link href="~/css/admin-dashboard.css"
          rel="stylesheet"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="admin-body">

    <div class="admin-wrapper">

        <!-- MOBILE SIDEBAR OVERLAY -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- SIDEBAR -->
        <aside class="admin-sidebar" id="adminSidebar">

            <div class="sidebar-brand">
                <a asp-controller="AdminDashboard"
                   asp-action="Index"
                   class="brand-link">

                    <span class="brand-icon">
                        <i class="bi bi-wallet2"></i>
                    </span>

                    <span class="brand-name">
                        KREDVANTA
                        <small>ADMINISTRATION</small>
                    </span>

                </a>

                <button type="button"
                        class="sidebar-close d-lg-none"
                        id="sidebarClose"
                        aria-label="Close navigation">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="sidebar-content">

                <div class="sidebar-section-label">
                    WORKSPACE
                </div>

                <nav class="sidebar-nav">

                    <a asp-controller="AdminDashboard"
                       asp-action="Index"
                       class="@(currentController == "AdminDashboard" ? "sidebar-link active" : "sidebar-link")">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Dashboard</span>
                    </a>

                    <a asp-controller="Borrowers"
                       asp-action="Index"
                       class="@(currentController == "Borrowers" ? "sidebar-link active" : "sidebar-link")">
                        <i class="bi bi-people"></i>
                        <span>Borrowers</span>
                    </a>

                    <a asp-controller="LoanProducts"
                       asp-action="Index"
                       class="@(currentController == "LoanProducts" ? "sidebar-link active" : "sidebar-link")">
                        <i class="bi bi-box-seam"></i>
                        <span>Loan Products</span>
                    </a>

                    <a asp-controller="LoanApplications"
                       asp-action="Index"
                       class="@(currentController == "LoanApplications" ? "sidebar-link active" : "sidebar-link")">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Loan Applications</span>
                    </a>

                    <div class="sidebar-section-label mt-4">
                        LENDING OPERATIONS
                    </div>

                    <a href="#"
                       class="sidebar-link disabled"
                       aria-disabled="true"
                       title="Coming soon">
                        <i class="bi bi-bank"></i>
                        <span>Loans & Disbursements</span>
                        <span class="coming-soon">Soon</span>
                    </a>

                    <a href="#"
                       class="sidebar-link disabled"
                       aria-disabled="true"
                       title="Coming soon">
                        <i class="bi bi-cash-stack"></i>
                        <span>Repayments</span>
                        <span class="coming-soon">Soon</span>
                    </a>

                    <div class="sidebar-section-label mt-4">
                        MANAGEMENT
                    </div>

                    <a href="#"
                       class="sidebar-link disabled"
                       aria-disabled="true"
                       title="Coming soon">
                        <i class="bi bi-person-gear"></i>
                        <span>User Management</span>
                        <span class="coming-soon">Soon</span>
                    </a>

                    <a href="#"
                       class="sidebar-link disabled"
                       aria-disabled="true"
                       title="Coming soon">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>Reports & Analytics</span>
                        <span class="coming-soon">Soon</span>
                    </a>

                    <a href="#"
                       class="sidebar-link disabled"
                       aria-disabled="true"
                       title="Coming soon">
                        <i class="bi bi-shield-check"></i>
                        <span>Audit Logs</span>
                        <span class="coming-soon">Soon</span>
                    </a>

                    <div class="sidebar-section-label mt-4">
                        SYSTEM
                    </div>

                    <a href="#"
                       class="sidebar-link disabled"
                       aria-disabled="true"
                       title="Coming soon">
                        <i class="bi bi-gear"></i>
                        <span>Settings</span>
                        <span class="coming-soon">Soon</span>
                    </a>

                </nav>

            </div>

            <div class="sidebar-footer">

                <div class="sidebar-support">
                    <div class="support-icon">
                        <i class="bi bi-headset"></i>
                    </div>

                    <div>
                        <strong>Kredvanta Support</strong>
                        <small>Administration portal</small>
                    </div>
                </div>

                <div class="sidebar-version">
                    KREDVANTA MANAGEMENT SYSTEM
                    <span>Administrator Portal</span>
                </div>

            </div>

        </aside>


        <!-- MAIN AREA -->
        <div class="admin-main">

            <!-- TOPBAR -->
            <header class="admin-topbar">

                <div class="topbar-left">

                    <button type="button"
                            class="sidebar-toggle"
                            id="sidebarToggle"
                            aria-label="Toggle navigation">
                        <i class="bi bi-list"></i>
                    </button>

                    <div class="topbar-heading">
                        <span>Administration</span>
                        <h6>@ViewData["Title"]</h6>
                    </div>

                </div>

                <div class="topbar-right">

                    <div class="admin-profile">

                        <div class="admin-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <div class="admin-profile-details">
                            <strong>
                                @(User.Identity?.Name ?? "Administrator")
                            </strong>
                            <small>Administrator</small>
                        </div>

                    </div>

                    <div class="dropdown">

                        <button class="topbar-menu-button"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                aria-label="Profile menu">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                            <li>
                                <span class="dropdown-item-text small text-muted">
                                    Signed in as administrator
                                </span>
                            </li>

                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <form asp-area="Identity"
                                      asp-page="/Account/Logout"
                                      asp-route-returnUrl="/"
                                      method="post">

                                    <button type="submit"
                                            class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Sign out
                                    </button>

                                </form>
                            </li>

                        </ul>

                    </div>

                </div>

            </header>


            <!-- PAGE CONTENT -->
            <main class="admin-content">

                @RenderBody()

            </main>


            <!-- FOOTER -->
            <footer class="admin-footer">

                <span>
                    © @DateTime.Now.Year Kredvanta.
                    All rights reserved.
                </span>

                <span>
                    Secure Digital Lending Platform
                </span>

            </footer>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const sidebar = document.getElementById("adminSidebar");
                const overlay = document.getElementById("sidebarOverlay");
                const toggle = document.getElementById("sidebarToggle");
                const close = document.getElementById("sidebarClose");

                function openSidebar() {
                    sidebar.classList.add("sidebar-open");
                    overlay.classList.add("overlay-visible");
                }

                function closeSidebar() {
                    sidebar.classList.remove("sidebar-open");
                    overlay.classList.remove("overlay-visible");
                }

                toggle?.addEventListener("click", openSidebar);
                close?.addEventListener("click", closeSidebar);
                overlay?.addEventListener("click", closeSidebar);

            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
