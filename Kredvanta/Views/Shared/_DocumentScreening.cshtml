@using Kredvanta.Services.Documents.Screening
@using static Kredvanta.Models.Enums.LendingEnums
@model Kredvanta.Models.Applications.LoanApplicationDocument

@{
    var checks = ScreeningJson.Parse(Model.ScreeningDetailsJson);

    var (badgeClass, label) = Model.ScreeningStatus switch
    {
        DocumentScreeningStatus.Passed => ("bg-success", "Automated checks passed"),
        DocumentScreeningStatus.Flagged => ("bg-warning text-dark", "Flagged for attention"),
        DocumentScreeningStatus.Failed => ("bg-danger", "Screening failed"),
        DocumentScreeningStatus.Queued or DocumentScreeningStatus.Scanning => ("bg-info text-dark", "Screening in progress"),
        _ => ("bg-secondary", "Not screened")
    };
}

<div class="border rounded p-3 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="badge @badgeClass">@label</span>
        @if (Model.ScreenedAt.HasValue)
        {
            <small class="text-muted">@Model.ScreenedAt.Value.ToString("dd MMM yyyy HH:mm") UTC</small>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ScreeningSummary))
    {
        <p class="mb-2">@Model.ScreeningSummary</p>
    }

    @if (checks.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-2">
                <thead>
                    <tr>
                        <th>Check</th>
                        <th>Result</th>
                        <th>Detail</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in checks)
                    {
                        <tr>
                            <td>
                                @c.Name
                                @if (!c.Required)
                                {
                                    <span class="badge bg-light text-muted border ms-1">info only</span>
                                }
                            </td>
                            <td>
                                @if (c.Outcome == CheckOutcome.Match)
                                {
                                    <i class="bi bi-check-circle-fill text-success" title="Match"></i>
                                }
                                else
                                {
                                    <i class="bi bi-exclamation-triangle-fill text-warning" title="@c.Outcome"></i>
                                }
                            </td>
                            <td class="small text-muted">@c.Detail</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <small class="text-muted">
        Automated pre-screening only. The reviewing officer's decision is final.
    </small>
</div>