@using static Kredvanta.Models.Enums.LendingEnums
@model Kredvanta.Controllers.StaffFinanceController.FinanceHome
@{
    ViewData["Title"] = "Disbursements";
    Layout = "_StaffLayout";
}

<h2 class="fw-bold mb-1">Disbursements</h2>
<p class="text-muted">Signed agreements waiting for the money to be sent, and what has been paid out recently.</p>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-bold">Ready to pay out</div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th class="ps-3">Application</th><th>Borrower</th><th>Product</th><th>Net proceeds</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.Ready)
                {
                    <tr>
                        <td class="ps-3 fw-semibold">@r.Number</td>
                        <td>@r.Borrower</td>
                        <td>@r.Product</td>
                        <td>@r.Currency @r.Net.ToString("N2")</td>
                        <td class="pe-3"><a class="btn btn-sm btn-primary" asp-action="Disburse" asp-route-id="@r.Id">Review payout</a></td>
                    </tr>
                }
                @if (!Model.Ready.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4"><i class="bi bi-check-circle me-1"></i>Nothing waiting.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-bold">Recent disbursements</div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th class="ps-3">Loan</th><th>Amount</th><th>Method</th><th>Reference</th><th>When</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var d in Model.Recent)
                {
                    <tr>
                        <td class="ps-3">@d.LoanNumber</td>
                        <td>@d.Currency @d.Amount.ToString("N2")</td>
                        <td>@d.Method</td>
                        <td>@d.Reference</td>
                        <td>@(d.At?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                        <td><span class="badge bg-secondary">@d.Status</span></td>
                    </tr>
                }
                @if (!Model.Recent.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No disbursements yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>