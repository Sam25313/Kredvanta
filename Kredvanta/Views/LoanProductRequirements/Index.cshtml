@model IEnumerable<Kredvanta.ViewModels.LoanProducts.LoanProductRequirementViewModel>

@{
    ViewData["Title"] = "Document Requirements";

    var loanProductId = (Guid)ViewBag.LoanProductId;
    var loanProductName = (string)ViewBag.LoanProductName;
    var productCode = (string)ViewBag.ProductCode;

    var totalRequirements = Model.Count();
    var mandatoryCount = Model.Count(x => x.IsMandatory);
    var optionalCount = Model.Count(x => !x.IsMandatory);
    var activeCount = Model.Count(x => x.IsActive);
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <a asp-controller="LoanProducts"
                   asp-action="Index"
                   class="text-decoration-none text-muted">
                    Loan Products
                </a>
                <i class="bi bi-chevron-right small text-muted"></i>
                <span class="text-muted small">Requirements</span>
            </div>

            <h3 class="fw-bold mb-1">Document Requirements</h3>

            <p class="text-muted mb-0">
                Manage the documents borrowers must submit when applying for
                <strong>@loanProductName</strong>.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="LoanProducts"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Products
            </a>

            <a asp-action="Create"
               asp-route-loanProductId="@loanProductId"
               class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Add Requirement
            </a>
        </div>
    </div>

    <!-- Product Information -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary bg-opacity-10 text-primary
                    d-flex align-items-center justify-content-center"
                     style="width:55px;height:55px;">
                    <i class="bi bi-folder2-open fs-3"></i>
                </div>

                <div>
                    <div class="text-muted small">Selected Loan Product</div>
                    <h5 class="fw-bold mb-1">@loanProductName</h5>
                    <span class="badge bg-light text-dark border">
                        @productCode
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Total Requirements</div>
                    <h3 class="fw-bold mb-0">@totalRequirements</h3>
                    <i class="bi bi-files text-primary fs-4"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Mandatory Documents</div>
                    <h3 class="fw-bold mb-0">@mandatoryCount</h3>
                    <span class="badge bg-danger-subtle text-danger mt-2">
                        Required
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Optional Documents</div>
                    <h3 class="fw-bold mb-0">@optionalCount</h3>
                    <span class="badge bg-info-subtle text-info mt-2">
                        Optional
                    </span>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Active Requirements</div>
                    <h3 class="fw-bold mb-0">@activeCount</h3>
                    <span class="badge bg-success-subtle text-success mt-2">
                        Currently Enforced
                    </span>
                </div>
            </div>
        </div>

    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Requirements Table -->
    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1">Configured Documents</h5>
                    <p class="text-muted small mb-0">
                        Documents required during the loan application process.
                    </p>
                </div>

                <span class="badge bg-light text-dark border">
                    @totalRequirements Documents
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5 px-3">
                    <div class="mb-3">
                        <i class="bi bi-folder-x display-3 text-muted"></i>
                    </div>

                    <h5 class="fw-bold">No requirements configured</h5>

                    <p class="text-muted">
                        This loan product does not have any document
                        requirements yet.
                    </p>

                    <a asp-action="Create"
                       asp-route-loanProductId="@loanProductId"
                       class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Configure First Requirement
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Document</th>
                                <th>Submission Period</th>
                                <th>Classification</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-start gap-3">
                                            <div class="rounded-2 bg-light
                                                d-flex align-items-center
                                                justify-content-center"
                                                 style="width:40px;height:40px;">
                                                <i class="bi bi-file-earmark-text
                                                text-primary fs-5"></i>
                                            </div>

                                            <div>
                                                <div class="fw-semibold">
                                                    @item.DocumentName
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                                {
                                                    <div class="text-muted small"
                                                         style="max-width:350px;">
                                                        @item.Description
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        @if (item.RequiredPeriodMonths.HasValue)
                                        {
                                            <span>
                                                Last @item.RequiredPeriodMonths
                                                months
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not specified</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsMandatory)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">
                                                Mandatory
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info">
                                                Optional
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit requirement">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <form asp-action="ToggleStatus"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to change this requirement status?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                        title="@(item.IsActive ? "Deactivate" : "Activate")">

                                                    <i class="bi @(item.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="alert alert-light border mt-4">
        <div class="d-flex gap-2">
            <i class="bi bi-info-circle text-primary fs-5"></i>
            <div>
                <strong>Important:</strong>
                Only active document requirements are presented to borrowers
                during the application process. Mandatory documents must be
                submitted before an application can be submitted.
            </div>
        </div>
    </div>

</div>
