@using Kredvanta.ViewModels.Dashboard

@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Administrator Dashboard";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="text-primary fw-semibold small">KINGS MICROFINANCE SETUP</span>
            <h2 class="fw-bold mb-1">Administrator Dashboard</h2>
            <p class="text-muted mb-0">
                Manage people, products and policy. Loan decisions are made by staff in their own workspace.
            </p>
        </div>
        <div class="mt-3 mt-md-0">
            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                <i class="bi bi-shield-check me-1"></i>Administrator
            </span>
        </div>
    </div>

    <!-- SETUP ACTIONS -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-2">
            <a asp-controller="AdminStaff" asp-action="Index" class="btn btn-primary w-100 py-3">
                <i class="bi bi-person-badge me-2"></i>Staff
            </a>
        </div>
        <div class="col-6 col-lg-2">
            <a asp-controller="LoanProducts" asp-action="Index" class="btn btn-outline-primary w-100 py-3">
                <i class="bi bi-box-seam me-2"></i>Loan Products
            </a>
        </div>
        <div class="col-6 col-lg-2">
            <a asp-controller="Borrowers" asp-action="Index" class="btn btn-outline-primary w-100 py-3">
                <i class="bi bi-people me-2"></i>Applicants
            </a>
        </div>
        <div class="col-6 col-lg-2">
            <a asp-controller="AuditLog" asp-action="Index" class="btn btn-outline-primary w-100 py-3">
                <i class="bi bi-journal-text me-2"></i>Audit Log
            </a>
        </div>
        <div class="col-6 col-lg-2">
            <a class="btn btn-outline-primary w-100 py-3" href="/policy">
                <i class="bi bi-sliders me-2"></i>Credit Policy
            </a>
        </div>
    </div>

    <!-- SETUP HEALTH -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-1">Setup health</h5>
                    <small class="text-muted">Things that would stop applications moving through the process.</small>
                </div>
                @if (Model.SetupWarnings.Any())
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2">
                        @Model.SetupWarnings.Count to fix
                    </span>
                }
                else
                {
                    <span class="badge bg-success-subtle text-success px-3 py-2">All good</span>
                }
            </div>

            @foreach (var w in Model.SetupWarnings)
            {
                <div class="alert alert-warning py-2 px-3 small mb-2">
                    <i class="bi bi-exclamation-triangle me-1"></i>@w
                </div>
            }

            @if (!Model.HasActiveCreditPolicy || !Model.HasActiveCreditManager)
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @if (!Model.HasActiveCreditPolicy)
                    {
                        <a asp-controller="CreditPolicyManagement" asp-action="Index" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-sliders me-1"></i>Manage policy (Credit Manager)
                        </a>
                    }
                    @if (!Model.HasActiveCreditManager)
                    {
                        <a asp-controller="AdminStaff" asp-action="Index" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-person-gear me-1"></i>Assign or activate a Credit Manager
                        </a>
                    }
                </div>
            }

            <div class="row g-3 mt-1">
                <div class="col-md-4">
                    <div class="small text-muted mb-1">Credit policy</div>
                    @if (Model.HasActiveCreditPolicy)
                    {
                        <div class="fw-semibold">v@Model.ActivePolicyVersion, @Model.ActivePolicyName</div>
                    }
                    else
                    {
                        <div class="fw-semibold text-danger">None active</div>
                    }
                </div>
                <div class="col-md-8">
                    <div class="small text-muted mb-1">Active staff by role</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var c in Model.RoleCoverage)
                        {
                            <span class="badge @(c.ActiveUsers > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-3 py-2">
                                @c.Role: @c.ActiveUsers
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SYSTEM OVERVIEW -->
    <h5 class="fw-bold mb-3">System Overview</h5>

    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Staff Accounts</p>
                            <h3 class="fw-bold mb-1">@Model.StaffCount</h3>
                            <small class="text-muted">@Model.ActiveStaffCount active, @Model.InactiveStaffCount deactivated</small>
                        </div>
                        <div class="rounded-3 bg-primary-subtle text-primary p-3"><i class="bi bi-person-badge fs-4"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Applicants</p>
                            <h3 class="fw-bold mb-1">@Model.TotalBorrowers</h3>
                            <small class="text-muted">@Model.BorrowerAccounts applicant accounts</small>
                        </div>
                        <div class="rounded-3 bg-info-subtle text-info p-3"><i class="bi bi-person-vcard fs-4"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Loan Products</p>
                            <h3 class="fw-bold mb-1">@Model.TotalLoanProducts</h3>
                            <small class="text-success">@Model.ActiveLoanProducts active</small>
                        </div>
                        <div class="rounded-3 bg-success-subtle text-success p-3"><i class="bi bi-box-seam fs-4"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between">
                        <div>
                            <p class="text-muted mb-1">Applications</p>
                            <h3 class="fw-bold mb-1">@Model.TotalApplications</h3>
                            <small class="text-warning-emphasis">@Model.PendingApplications in progress</small>
                        </div>
                        <div class="rounded-3 bg-warning-subtle text-warning-emphasis p-3"><i class="bi bi-file-earmark-text fs-4"></i></div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- PRODUCT AVAILABILITY -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold mb-1">Loan Product Availability</h5>
            <small class="text-muted">Products currently visible and open for applications.</small>
        </div>
        <a asp-controller="LoanProducts" asp-action="Index" class="btn btn-sm btn-outline-primary mt-2 mt-md-0">
            <i class="bi bi-gear me-1"></i>Manage Products
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Open for applications</p>
                            <h2 class="fw-bold text-success mb-1">@Model.AvailableLoanProducts</h2>
                            <small class="text-muted">Active products accepting applications</small>
                        </div>
                        <div class="rounded-3 bg-success-subtle text-success p-3"><i class="bi bi-check-circle fs-3"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Temporarily unavailable</p>
                            <h2 class="fw-bold text-warning mb-1">@Model.UnavailableLoanProducts</h2>
                            <small class="text-muted">Active products not accepting applications</small>
                        </div>
                        <div class="rounded-3 bg-warning-subtle text-warning p-3"><i class="bi bi-pause-circle fs-3"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- APPLICATION OVERVIEW (counts only) -->
    <h5 class="fw-bold mb-1">Loan Application Overview</h5>
    <p class="text-muted small mb-3">Totals only. Applications are worked on by staff in their own workspace.</p>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">In progress</p>
                    <h3 class="fw-bold text-warning">@Model.PendingApplications</h3>
                    <small class="text-muted">Awaiting completion or decision</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Under review</p>
                    <h3 class="fw-bold text-primary">@Model.ApplicationsUnderReview</h3>
                    <small class="text-muted">Being assessed by staff</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Approved</p>
                    <h3 class="fw-bold text-success">@Model.ApprovedApplications</h3>
                    <small class="text-muted">Applications approved</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Rejected</p>
                    <h3 class="fw-bold text-danger">@Model.RejectedApplications</h3>
                    <small class="text-muted">Applications rejected</small>
                </div>
            </div>
        </div>
    </div>

    <!-- PORTFOLIO -->
    <h5 class="fw-bold mb-3">Loan Portfolio</h5>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">Total disbursed principal</p>
                    <h3 class="fw-bold text-primary">KES @Model.TotalDisbursedPrincipal.ToString("N2")</h3>
                    <small class="text-muted">Loans with a recorded disbursement date</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">Outstanding balance</p>
                    <h3 class="fw-bold text-danger">KES @Model.TotalOutstandingBalance.ToString("N2")</h3>
                    <small class="text-muted">Remaining loan balances</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <p class="text-muted mb-1">Confirmed repayments</p>
                    <h3 class="fw-bold text-success">KES @Model.TotalConfirmedRepayments.ToString("N2")</h3>
                    <small class="text-muted">Successfully confirmed payments</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Total loans</p>
                    <h3 class="fw-bold">@Model.TotalLoans</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Active loans</p>
                    <h3 class="fw-bold text-success">@Model.ActiveLoans</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Overdue loans</p>
                    <h3 class="fw-bold text-danger">@Model.OverdueLoans</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <p class="text-muted mb-1">Pending repayments</p>
                    <h3 class="fw-bold text-warning">@Model.PendingRepayments</h3>
                    <small class="text-muted">Of @Model.TotalRepayments transactions</small>
                </div>
            </div>
        </div>
    </div>

</div>