@using Kredvanta.Models.Products
@model LoanProduct

@{
    ViewData["Title"] = Model.ProductName + " - Loan Details";

    var activeDocuments = Model.RequiredDocuments?
        .Where(d => d.IsActive)
        .ToList() ?? new List<LoanProductRequiredDocument>();

    var requiredDocuments = activeDocuments
        .Where(d => d.IsMandatory)
        .ToList();

    var optionalDocuments = activeDocuments
        .Where(d => !d.IsMandatory)
        .ToList();
}

<div class="container py-4">

    <!-- Breadcrumb -->
    <div class="mb-4">
        <a asp-controller="LoanProducts"
           asp-action="Index"
           class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-2"></i>Back to Loan Products
        </a>
    </div>

    <!-- Product Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-lg-5">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-4">

                <div>
                    <span class="badge bg-primary-subtle text-primary mb-3">
                        @Model.Category
                    </span>

                    <h2 class="fw-bold mb-2">@Model.ProductName</h2>

                    <p class="text-muted mb-3">
                        @Model.Description
                    </p>

                    <span class="text-muted small">
                        Product Code: @Model.ProductCode
                    </span>
                </div>

                <div class="text-md-end">
                    <span class="badge bg-success-subtle text-success px-3 py-2">
                        <i class="bi bi-check-circle me-1"></i>
                        Available
                    </span>

                    <div class="mt-3">
                        <span class="text-muted small d-block">
                            Annual Interest Rate
                        </span>
                        <h2 class="fw-bold text-primary mb-0">
                            @Model.AnnualInterestRate.ToString("N2")%
                        </h2>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Loan Information -->
    <h5 class="fw-bold mb-3">Loan Overview</h5>

    <div class="row g-3 mb-4">

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <i class="bi bi-cash-stack text-primary fs-4"></i>
                    <p class="text-muted small mt-3 mb-1">Minimum Loan Amount</p>
                    <h5 class="fw-bold">
                        KES @Model.MinimumAmount.ToString("N2")
                    </h5>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <i class="bi bi-wallet2 text-primary fs-4"></i>
                    <p class="text-muted small mt-3 mb-1">Maximum Loan Amount</p>
                    <h5 class="fw-bold">
                        KES @Model.MaximumAmount.ToString("N2")
                    </h5>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <i class="bi bi-calendar-range text-primary fs-4"></i>
                    <p class="text-muted small mt-3 mb-1">Minimum Term</p>
                    <h5 class="fw-bold">
                        @Model.MinimumTermPeriods @Model.RepaymentFrequency
                    </h5>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <i class="bi bi-calendar-check text-primary fs-4"></i>
                    <p class="text-muted small mt-3 mb-1">Maximum Term</p>
                    <h5 class="fw-bold">
                        @Model.MaximumTermPeriods @Model.RepaymentFrequency
                    </h5>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <!-- Loan Terms -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-file-earmark-text text-primary me-2"></i>
                        Loan Terms and Conditions
                    </h5>

                    <div class="row g-4">

                        <div class="col-sm-6">
                            <span class="text-muted small d-block">
                                Interest Method
                            </span>
                            <strong>@Model.InterestMethod</strong>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted small d-block">
                                Repayment Frequency
                            </span>
                            <strong>@Model.RepaymentFrequency</strong>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted small d-block">
                                Processing Fee (Percentage)
                            </span>
                            <strong>
                                @Model.ProcessingFeePercentage.ToString("N2")%
                            </strong>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted small d-block">
                                Fixed Processing Fee
                            </span>
                            <strong>
                                KES @Model.ProcessingFeeFixed.ToString("N2")
                            </strong>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted small d-block">
                                Grace Period
                            </span>
                            <strong>@Model.GracePeriodDays days</strong>
                        </div>

                        <div class="col-sm-6">
                            <span class="text-muted small d-block">
                                Maximum Repayment Term
                            </span>
                            <strong>
                                @Model.MaximumTermPeriods @Model.RepaymentFrequency
                            </strong>
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="alert alert-info border-0 rounded-3 mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        The actual amount offered, applicable fees and repayment
                        schedule will be determined during the loan assessment
                        process and communicated before acceptance.
                    </div>

                </div>
            </div>
        </div>

        <!-- Required Documents -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">

                    <h5 class="fw-bold mb-2">
                        <i class="bi bi-folder-check text-primary me-2"></i>
                        Required Documents
                    </h5>

                    <p class="text-muted small mb-4">
                        Prepare the following documents before completing
                        your loan application.
                    </p>

                    @if (requiredDocuments.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var document in requiredDocuments)
                            {
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex gap-3">
                                        <i class="bi bi-file-earmark-check text-success fs-4"></i>

                                        <div>
                                            <div class="fw-semibold">
                                                @document.DocumentName
                                                <span class="badge bg-danger-subtle text-danger ms-1">
                                                    Required
                                                </span>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(document.Description))
                                            {
                                                <small class="text-muted">
                                                    @document.Description
                                                </small>
                                            }

                                            @if (document.RequiredPeriodMonths.HasValue)
                                            {
                                                <div class="small text-muted mt-1">
                                                    Period covered:
                                                    @document.RequiredPeriodMonths months
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border">
                            No mandatory supporting documents have been
                            configured for this product yet.
                        </div>
                    }

                    @if (optionalDocuments.Any())
                    {
                        <hr />

                        <h6 class="fw-bold mb-3">Additional Documents</h6>

                        @foreach (var document in optionalDocuments)
                        {
                            <div class="d-flex gap-2 mb-3">
                                <i class="bi bi-file-earmark text-secondary"></i>
                                <div>
                                    <div class="fw-semibold small">
                                        @document.DocumentName
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(document.Description))
                                    {
                                        <small class="text-muted">
                                            @document.Description
                                        </small>
                                    }
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>
        </div>

    </div>

    <!-- Application Action -->
    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">

                <div>
                    <h5 class="fw-bold mb-1">Ready to get started?</h5>
                    <p class="text-muted mb-0 small">
                        Submit your application to begin the assessment process.
                    </p>
                </div>

                <a asp-controller="LoanApplications"
                   asp-action="Create"
                   asp-route-loanProductId="@Model.Id"
                   class="btn btn-primary btn-lg px-4">
                    Apply for This Loan
                    <i class="bi bi-arrow-right ms-2"></i>
                </a>

            </div>
        </div>
    </div>

    <p class="text-muted small text-center mt-4">
        Applying for a loan does not guarantee approval. All applications
        are subject to identity verification, eligibility checks,
        credit assessment and the applicable lending terms.
    </p>

</div>
