@using static Kredvanta.Models.Enums.LendingEnums
@model Kredvanta.ViewModels.LoanApplications.LoanApplicationDetailsViewModel

@functions {
    // Applicant-facing summary of one document requirement.
    static (string Icon, string Tone, string Text) Describe(bool isUploaded, DocumentReviewStatus? status)
    {
        if (!isUploaded)
            return ("bi-cloud-arrow-up", "text-muted", "Not uploaded yet");

        return status switch
        {
            DocumentReviewStatus.Verified =>
                ("bi-check-circle-fill", "text-success", "Accepted"),
            DocumentReviewStatus.Rejected =>
                ("bi-x-circle-fill", "text-danger", "Rejected. Upload a new file."),
            DocumentReviewStatus.ClarificationRequired =>
                ("bi-exclamation-triangle-fill", "text-warning-emphasis", "More information needed. Upload a new file."),
            _ =>
                ("bi-file-earmark-check-fill", "text-primary", "Under review")
        };
    }
}

@{
    ViewData["Title"] = "Loan Application Details";

    var statusClass = Model.Status switch
    {
        LoanApplicationStatus.Draft => "bg-secondary",
        LoanApplicationStatus.Submitted => "bg-primary",
        LoanApplicationStatus.UnderReview => "bg-info text-dark",
        LoanApplicationStatus.DocumentsRequired => "bg-warning text-dark",
        LoanApplicationStatus.Recommended => "bg-info text-dark",
        LoanApplicationStatus.Approved => "bg-success",
        LoanApplicationStatus.Rejected => "bg-danger",
        LoanApplicationStatus.Cancelled => "bg-dark",
        _ => "bg-secondary"
    };

    var mandatoryDocuments = Model.RequiredDocuments.Where(d => d.IsMandatory).ToList();
    var mandatoryCount = mandatoryDocuments.Count;
    var acceptedCount = mandatoryDocuments.Count(d => d.ReviewStatus == DocumentReviewStatus.Verified && d.IsUploaded);
    var suppliedCount = mandatoryDocuments.Count(d => d.IsSatisfied);
    var documentsToFix = mandatoryDocuments.Where(d => !d.IsSatisfied).ToList();
    var canSubmit = (Model.Status is LoanApplicationStatus.Draft or LoanApplicationStatus.DocumentsRequired)
                    && documentsToFix.Count == 0;
    var percent = mandatoryCount == 0 ? 100 : suppliedCount * 100 / mandatoryCount;
}

<style>
    .slot-list {
        background: var(--bs-body-bg);
    }

    .slot {
        position: relative;
        display: grid;
        grid-template-columns: 2rem 1fr auto;
        column-gap: 1rem;
        align-items: center;
        padding: 1.1rem 1.5rem;
        border-top: 1px solid var(--bs-border-color);
        transition: background-color .15s ease;
    }

        .slot.is-droppable:hover {
            background: var(--bs-tertiary-bg);
        }

    /* The upload form covers the whole row, so the row is the click and drop target. */
    .slot-form {
        position: absolute;
        inset: 0;
        margin: 0;
    }

    .slot-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .slot:focus-within {
        outline: 2px solid var(--bs-primary);
        outline-offset: -2px;
    }

    .slot.is-dragover {
        background: var(--bs-primary-bg-subtle);
        outline: 2px dashed var(--bs-primary);
        outline-offset: -8px;
    }

    .slot-icon {
        font-size: 1.5rem;
        line-height: 1;
    }

    .slot-action {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        justify-content: flex-end;
    }

        .slot-action .slot-pick {
            pointer-events: none;
        }

        .slot-action a {
            position: relative;
            z-index: 2;
        }
    /* stay clickable above the upload overlay */

    /* Front and back ID photo capture */
    .slot-panel {
        grid-column: 1 / -1;
        grid-row: 2;
        position: relative;
        z-index: 2;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px dashed var(--bs-border-color);
    }

        .slot-panel label.btn {
            position: relative;
        }

    .id-preview {
        aspect-ratio: 1.586; /* standard ID card proportions */
        display: grid;
        place-items: center;
        overflow: hidden;
        border: 2px dashed var(--bs-border-color);
        border-radius: .5rem;
        background: var(--bs-tertiary-bg);
    }

        .id-preview img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .id-preview.is-filled {
            border-style: solid;
            border-color: var(--bs-success);
        }

    @@media (max-width: 575.98px) {
        .slot-panel {
            grid-row: 3;
        }
    }

    /* One motion language: a bar sweeps along a row while work is happening on it. */
    .slot.is-uploading,
    .slot.is-checking {
        background: var(--bs-tertiary-bg);
    }

        .slot.is-uploading .slot-input {
            cursor: progress;
        }

        .slot.is-uploading::after,
        .slot.is-checking::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            height: 3px;
            width: 35%;
            background: var(--bs-primary);
            animation: slot-sweep 1.2s ease-in-out infinite;
        }

    @@keyframes slot-sweep {
        from {
            transform: translateX(-100%);
        }

        to {
            transform: translateX(290%);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .slot.is-uploading::after,
        .slot.is-checking::after {
            animation: none;
            width: 100%;
            opacity: .5;
        }

        .slot {
            transition: none;
        }
    }

    @@media (max-width: 575.98px) {
        .slot {
            grid-template-columns: 2rem 1fr;
            row-gap: .75rem;
            padding: 1rem;
        }

        .slot-action {
            grid-column: 2;
            justify-content: flex-start;
        }
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Loan Application Details</h2>
            <p class="text-muted mb-0">Review your application and supporting documents.</p>
        </div>
        <a asp-controller="LoanApplications" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Applications
        </a>
    </div>

    @foreach (var (key, css) in new[] { ("Success", "success"), ("Error", "danger"), ("Warning", "warning") })
    {
        if (TempData[key] != null)
        {
            <div class="alert alert-@css alert-dismissible fade show" role="alert">
                @TempData[key]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    }

    <!-- Overview -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-start mb-4">
                <div>
                    <span class="text-muted small">APPLICATION NUMBER</span>
                    <h4 class="fw-bold mb-1">@Model.ApplicationNumber</h4>
                    <span class="text-muted">Created on @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                </div>
                <span class="badge @statusClass fs-6 px-3 py-2 mt-2 mt-md-0">@Model.Status</span>
            </div>

            <hr />

            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="text-muted small mb-1">Loan Product</div>
                    <div class="fw-semibold">@Model.LoanProductName</div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="text-muted small mb-1">Requested Amount</div>
                    <div class="fw-semibold">KES @Model.RequestedAmount.ToString("N2")</div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="text-muted small mb-1">Repayment Term</div>
                    <div class="fw-semibold">@Model.RequestedTermPeriods periods</div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="text-muted small mb-1">Submitted On</div>
                    <div class="fw-semibold">
                        @(Model.SubmittedAt.HasValue
                            ? Model.SubmittedAt.Value.ToLocalTime().ToString("dd MMM yyyy")
                            : "Not yet submitted")
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <div class="text-muted small mb-1">Loan Purpose</div>
                <p class="mb-0">@Model.LoanPurpose</p>
            </div>

            @if (Model.DecisionAt.HasValue)
            {
                <div class="mt-3">
                    <div class="text-muted small mb-1">Decision Date</div>
                    <div class="fw-semibold">@Model.DecisionAt.Value.ToLocalTime().ToString("dd MMM yyyy")</div>
                </div>
            }
        </div>
    </div>

    <!-- Next step -->
    @if (Model.CanUploadDocuments)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h5 class="fw-bold mb-1">Next step</h5>
                        <p class="text-muted mb-0">
                            @if (canSubmit)
                            {
                                <span>Everything required is in. Submit your application for verification.</span>
                            }
                            else
                            {
                                <span>
                                    @(documentsToFix.Count == 1 ? "1 required document is" : $"{documentsToFix.Count} required documents are")
                                    still needed. Add or replace them in the checklist below, then submit.
                                </span>
                            }
                        </p>
                    </div>

                    @if (canSubmit)
                    {
                        <form asp-controller="LoanApplications" asp-action="Submit" asp-route-id="@Model.Id"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to submit this loan application for verification?');">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-send me-1"></i> Submit for Verification
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Required documents -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden">
        <div class="p-4 pb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
                <h5 class="fw-bold mb-0">Required documents</h5>
                @if (mandatoryCount > 0)
                {
                    <span class="fw-semibold">
                        @suppliedCount of @mandatoryCount provided<span class="text-muted fw-normal">, @acceptedCount accepted</span>
                    </span>
                }
            </div>

            @if (mandatoryCount > 0)
            {
                <div class="progress mt-2" style="height: 6px;"
                     role="progressbar" aria-label="Required documents provided"
                     aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(suppliedCount == mandatoryCount ? "bg-success" : "")"
                         style="width: @(percent)%"></div>
                </div>
            }

            <p class="small text-muted mb-0 mt-2">
                PDF, PNG or JPG, up to 5 MB each. Phone photos are fine if the text is sharp and every edge
                is in view. Uploading a document does not mean it is accepted: we check each file against
                your profile, then our team reviews it.
            </p>
        </div>

        @if (Model.RequiredDocuments.Any())
        {
            <div class="slot-list">
                @foreach (var item in Model.RequiredDocuments)
                {
                    var canUpload = Model.CanUploadDocuments && item.ReviewStatus != DocumentReviewStatus.Verified;
                    var (icon, tone, text) = Describe(item.IsUploaded, item.ReviewStatus);
                    // A requirement named like "National ID (front and back)" gets the two-photo capture flow.
                    var isIdBothSides = item.DocumentName.Contains("front", StringComparison.OrdinalIgnoreCase)
                                        && item.DocumentName.Contains("back", StringComparison.OrdinalIgnoreCase);

                    <div class="slot @(canUpload && !isIdBothSides ? "is-droppable" : "")"
                         data-slot
                         data-document-id="@item.DocumentId">

                        @if (canUpload && !isIdBothSides)
                        {
                            <form asp-controller="ApplicationDocuments" asp-action="Upload"
                                  asp-route-applicationId="@Model.Id"
                                  method="post" enctype="multipart/form-data"
                                  class="slot-form">
                                <input type="hidden" name="requiredDocumentId" value="@item.Id" />
                                <input type="file" name="file"
                                       class="slot-input"
                                       accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg"
                                       aria-label="@(item.IsUploaded ? "Replace" : "Upload") @item.DocumentName" />
                            </form>
                        }

                        <i class="bi @icon @tone slot-icon" aria-hidden="true"></i>

                        <div>
                            <div class="fw-semibold">
                                @item.DocumentName
                                <span class="badge rounded-pill text-bg-light border fw-normal ms-1">
                                    @(item.IsMandatory ? "Required" : "Optional")
                                </span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="small text-muted">@item.Description</div>
                            }

                            @if (item.RequiredPeriodMonths.HasValue)
                            {
                                <div class="small text-muted">Must cover @item.RequiredPeriodMonths months.</div>
                            }

                            <div class="small mt-1 @tone" data-status>@text</div>

                            @if (item.IsUploaded)
                            {
                                <div class="small text-muted">
                                    Version @item.Version, uploaded @item.UploadedAt?.ToLocalTime().ToString("dd MMM yyyy")
                                </div>
                            }
                            else if (canUpload && !isIdBothSides)
                            {
                                <div class="small text-muted d-none d-md-block">Drop a file here or click to browse.</div>
                            }

                            <div class="small text-muted" data-screening></div>

                            @if (!string.IsNullOrWhiteSpace(item.BorrowerMessage))
                            {
                                <div class="small mt-2 p-2 rounded bg-body-secondary">
                                    Note from our team: @item.BorrowerMessage
                                </div>
                            }

                            <div class="small text-danger mt-1 d-none" data-error role="alert"></div>
                        </div>

                        @if (canUpload && isIdBothSides)
                        {
                            <div class="slot-panel d-none" data-id-panel>
                                <p class="small text-muted mb-3">
                                    Take one clear photo of each side, or choose photos you already have. Lay the ID on a flat,
                                    well-lit surface, fill the frame, and avoid glare and shadows.
                                </p>

                                <div class="row g-3">
                                    @foreach (var side in new[] {
                                        ("front", "Front", "The side with your photo and ID number."),
                                        ("back", "Back", "The other side of the card.") })
                                    {
                                        <div class="col-6" data-side="@side.Item1">
                                            <div class="id-preview mb-2" data-preview>
                                                <i class="bi bi-credit-card-2-front fs-1 text-muted" aria-hidden="true"></i>
                                            </div>
                                            <div class="fw-semibold">@side.Item2</div>
                                            <div class="small text-muted mb-2">@side.Item3</div>
                                            <div class="d-flex flex-wrap gap-2">
                                                <label class="btn btn-sm btn-primary mb-0">
                                                    <i class="bi bi-camera me-1"></i>Take photo
                                                    <input type="file" class="visually-hidden" accept="image/*" capture="environment" data-side-input />
                                                </label>
                                                <label class="btn btn-sm btn-outline-secondary mb-0">
                                                    Choose file
                                                    <input type="file" class="visually-hidden" accept="image/*" data-side-input />
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="small text-danger mt-2 d-none" data-id-error role="alert"></div>

                                <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                    <button type="button" class="btn btn-primary" data-id-submit disabled>
                                        <i class="bi bi-cloud-arrow-up me-1"></i>Upload ID
                                    </button>
                                    <button type="button" class="btn btn-link" data-id-cancel>Cancel</button>
                                    <label class="small text-muted ms-auto mb-0 position-relative" style="cursor:pointer">
                                        Have a PDF or one image showing both sides?
                                        <span class="text-decoration-underline">Upload it instead</span>
                                        <input type="file" class="visually-hidden"
                                               accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg"
                                               data-id-single />
                                    </label>
                                </div>

                                <form asp-controller="ApplicationDocuments" asp-action="Upload"
                                      asp-route-applicationId="@Model.Id"
                                      method="post" enctype="multipart/form-data" data-id-form>
                                    <input type="hidden" name="requiredDocumentId" value="@item.Id" />
                                    <input type="file" name="file" class="d-none" />
                                </form>
                            </div>
                        }

                        <div class="slot-action">
                            @if (item.DocumentId.HasValue)
                            {
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="ApplicationDocuments" asp-action="Download"
                                   asp-route-applicationId="@Model.Id"
                                   asp-route-documentId="@item.DocumentId">
                                    Download
                                </a>
                            }

                            @if (canUpload && isIdBothSides)
                            {
                                <button type="button"
                                        class="btn btn-sm @(item.IsUploaded ? "btn-outline-primary" : "btn-primary")"
                                        data-id-open aria-expanded="false">
                                    <i class="bi bi-camera me-1"></i>@(item.IsUploaded ? "Replace photos" : "Add photos")
                                </button>
                            }
                            else if (canUpload)
                            {
                                <span class="btn btn-sm slot-pick @(item.IsUploaded ? "btn-outline-primary" : "btn-primary")">
                                    @(item.IsUploaded ? "Replace" : "Choose file")
                                </span>
                                <noscript>
                                    <span class="small text-muted">Turn on JavaScript to upload.</span>
                                </noscript>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 border-top">
                <i class="bi bi-folder2-open display-5 text-muted"></i>
                <p class="text-muted mt-2 mb-0">No document requirements have been configured for this loan product.</p>
            </div>
        }
    </div>

    <!-- Upload history -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-1"><i class="bi bi-file-earmark-text me-2"></i> Upload History</h5>
            <p class="text-muted small mb-0">Every file you have uploaded, including replaced versions.</p>
        </div>

        <div class="card-body p-0">
            @if (Model.Documents.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">File</th>
                                <th>Document</th>
                                <th>Version</th>
                                <th>Status</th>
                                <th>Uploaded</th>
                                <th class="pe-4">Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.Documents)
                            {
                                <tr class="@(d.IsCurrent ? "" : "text-muted")">
                                    <td class="ps-4">
                                        <i class="bi bi-file-earmark me-2"></i>@d.OriginalFileName
                                    </td>
                                    <td>@d.RequiredDocumentName</td>
                                    <td>
                                        v@d.Version
                                        @if (!d.IsCurrent)
                                        {
                                            <span class="badge bg-light text-muted border ms-1">Replaced</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (d.ReviewStatus)
                                        {
                                            case DocumentReviewStatus.Verified:
                                                <span class="badge bg-success">Accepted</span>
                                                break;
                                            case DocumentReviewStatus.Rejected:
                                                <span class="badge bg-danger">Rejected</span>
                                                break;
                                            case DocumentReviewStatus.ClarificationRequired:
                                                <span class="badge bg-info text-dark">More information needed</span>
                                                break;
                                            default:
                                                <span class="badge bg-warning text-dark">Under review</span>
                                                break;
                                        }
                                    </td>
                                    <td>@d.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td class="pe-4">
                                        @(string.IsNullOrWhiteSpace(d.ReviewComments) ? "—" : d.ReviewComments)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-x display-5 text-muted"></i>
                    <p class="text-muted mt-2 mb-0">You have not uploaded any documents yet.</p>
                </div>
            }
        </div>
    </div>

    <!-- History -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-1"><i class="bi bi-clock-history me-2"></i> Application History</h5>
            <p class="text-muted small mb-0">Important events and status changes.</p>
        </div>

        <div class="card-body">
            @if (Model.History.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.History)
                    {
                        <div class="list-group-item px-0 py-3">
                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <div>
                                    <div class="fw-semibold">
                                        @if (item.PreviousStatus.HasValue)
                                        {
                                            <span>@item.PreviousStatus.Value</span>
                                            <i class="bi bi-arrow-right mx-2 text-muted"></i>
                                        }
                                        <span>@item.NewStatus</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <p class="text-muted small mb-1 mt-1">@item.Notes</p>
                                    }
                                    <small class="text-muted">Changed by: @(item.ChangedByName ?? "System")</small>
                                </div>
                                <small class="text-muted">@item.ChangedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-3 mb-0">No application history is available.</p>
            }
        </div>
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            // ---------------------------------------------------------------- uploads
            const MAX_BYTES = 5 * 1024 * 1024;
            const ALLOWED = ['pdf', 'png', 'jpg', 'jpeg'];

            function setError(slot, message) {
                const el = slot.querySelector('[data-error]');
                el.textContent = message;
                el.classList.toggle('d-none', !message);
            }

            document.querySelectorAll('[data-slot]').forEach(function (slot) {
                const input = slot.querySelector('.slot-input');
                if (!input) return;   // row is not uploadable (e.g. already accepted)
                const status = slot.querySelector('[data-status]');

                ['dragenter', 'dragover'].forEach(function (name) {
                    input.addEventListener(name, function () { slot.classList.add('is-dragover'); });
                });
                ['dragleave', 'drop'].forEach(function (name) {
                    input.addEventListener(name, function () { slot.classList.remove('is-dragover'); });
                });

                input.addEventListener('change', function () {
                    setError(slot, '');
                    const file = input.files && input.files[0];
                    if (!file) return;

                    const ext = (file.name.split('.').pop() || '').toLowerCase();
                    let problem = '';
                    if (!ALLOWED.includes(ext)) problem = 'Use a PDF, PNG or JPG file.';
                    else if (file.size === 0) problem = 'This file is empty. Choose another one.';
                    else if (file.size > MAX_BYTES) problem = 'This file is larger than 5 MB. Choose a smaller file or a lower-resolution photo.';

                    if (problem) {
                        input.value = '';
                        setError(slot, problem);
                        return;
                    }

                    slot.classList.add('is-uploading');
                    status.textContent = 'Uploading ' + file.name + '…';

                    // One upload at a time: lock the other rows, then send this one.
                    document.querySelectorAll('.slot-input').forEach(function (other) {
                        if (other !== input) other.disabled = true;
                    });
                    input.form.submit();
                });
            });

            // ------------------------------------------- front and back ID photos
            // Both photos are combined in the browser into ONE JPEG, which then goes through the
            // normal upload form, so the server and the screening pipeline need no changes.
            function composeIdImage(frontImg, backImg) {
                const MAX_WIDTH = 1600, GAP = 24, LIMIT = 4.5 * 1024 * 1024;
                let width = Math.min(MAX_WIDTH, Math.max(frontImg.naturalWidth, backImg.naturalWidth));

                function attempt(triesLeft) {
                    const frontH = Math.round(frontImg.naturalHeight * width / frontImg.naturalWidth);
                    const backH = Math.round(backImg.naturalHeight * width / backImg.naturalWidth);

                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = frontH + GAP + backH;

                    const ctx = canvas.getContext('2d');
                    ctx.fillStyle = '#ffffff';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);
                    ctx.drawImage(frontImg, 0, 0, width, frontH);
                    ctx.drawImage(backImg, 0, frontH + GAP, width, backH);

                    return new Promise(function (resolve) {
                        canvas.toBlob(function (blob) {
                            if (blob && blob.size <= LIMIT) return resolve(blob);
                            if (triesLeft <= 1) return resolve(null);
                            width = Math.round(width * 0.8);   // too big: shrink and try again
                            resolve(attempt(triesLeft - 1));
                        }, 'image/jpeg', 0.85);
                    });
                }
                return attempt(4);
            }

            document.querySelectorAll('[data-id-panel]').forEach(function (panel) {
                const slot = panel.closest('[data-slot]');
                const openBtn = slot.querySelector('[data-id-open]');
                const form = panel.querySelector('[data-id-form]');
                const fileField = form.querySelector('input[type=file]');
                const submitBtn = panel.querySelector('[data-id-submit]');
                const submitHtml = submitBtn.innerHTML;
                const errorEl = panel.querySelector('[data-id-error]');
                const status = slot.querySelector('[data-status]');
                const sides = {};   // { front: { img, url }, back: { img, url } }

                function showError(message) {
                    errorEl.textContent = message;
                    errorEl.classList.toggle('d-none', !message);
                }

                function refresh() {
                    submitBtn.disabled = !(sides.front && sides.back);
                }

                function send(file) {
                    try {
                        const transfer = new DataTransfer();
                        transfer.items.add(file);
                        fileField.files = transfer.files;
                    } catch (e) {
                        showError("This browser can't prepare the photos. Use \"Upload it instead\" with a single file.");
                        return false;
                    }
                    slot.classList.add('is-uploading');
                    if (status) status.textContent = 'Uploading ' + file.name + '…';
                    document.querySelectorAll('.slot-input').forEach(function (other) { other.disabled = true; });
                    form.submit();
                    return true;
                }

                openBtn.addEventListener('click', function () {
                    const nowOpen = !panel.classList.toggle('d-none');
                    openBtn.setAttribute('aria-expanded', String(nowOpen));
                });

                panel.querySelector('[data-id-cancel]').addEventListener('click', function () {
                    panel.classList.add('d-none');
                    openBtn.setAttribute('aria-expanded', 'false');
                });

                // One photo per side, from the camera or from existing files.
                panel.querySelectorAll('[data-side]').forEach(function (tile) {
                    const side = tile.dataset.side;
                    const preview = tile.querySelector('[data-preview]');

                    tile.querySelectorAll('[data-side-input]').forEach(function (input) {
                        input.addEventListener('change', function () {
                            showError('');
                            const file = input.files && input.files[0];
                            input.value = '';   // lets the same photo be chosen again
                            if (!file) return;

                            if (!file.type || file.type.indexOf('image/') !== 0) {
                                showError('Choose a photo (JPG or PNG).');
                                return;
                            }

                            const url = URL.createObjectURL(file);
                            const img = new Image();
                            img.alt = side + ' of your ID';
                            img.onload = function () {
                                if (sides[side]) URL.revokeObjectURL(sides[side].url);
                                sides[side] = { img: img, url: url };
                                preview.replaceChildren(img);
                                preview.classList.add('is-filled');
                                refresh();
                            };
                            img.onerror = function () {
                                URL.revokeObjectURL(url);
                                showError("We couldn't read that photo. Try taking it again.");
                            };
                            img.src = url;
                        });
                    });
                });

                // Combine the two photos and upload.
                submitBtn.addEventListener('click', async function () {
                    if (!(sides.front && sides.back)) return;
                    showError('');
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Preparing…';

                    let sent = false;
                    try {
                        const blob = await composeIdImage(sides.front.img, sides.back.img);
                        if (blob) {
                            sent = send(new File([blob], 'national-id-front-and-back.jpg', { type: 'image/jpeg' }));
                        } else {
                            showError('These photos are too large. Retake them a little further from the ID.');
                        }
                    } catch (e) {
                        showError("We couldn't prepare these photos. Try taking them again.");
                    }

                    if (!sent) {
                        submitBtn.innerHTML = submitHtml;
                        refresh();
                    }
                });

                // Fallback: one PDF or one image that already shows both sides.
                panel.querySelector('[data-id-single]').addEventListener('change', function (e) {
                    showError('');
                    const file = e.target.files && e.target.files[0];
                    e.target.value = '';
                    if (!file) return;

                    const ext = (file.name.split('.').pop() || '').toLowerCase();
                    if (!ALLOWED.includes(ext)) { showError('Use a PDF, PNG or JPG file.'); return; }
                    if (file.size === 0) { showError('This file is empty. Choose another one.'); return; }
                    if (file.size > MAX_BYTES) { showError('This file is larger than 5 MB. Choose a smaller one.'); return; }
                    send(file);
                });
            });

            window.addEventListener('pageshow', function (e) {
                if (e.persisted) window.location.reload();
            });

            // ------------------------------------------------- live screening status
            const rows = new Map();
            document.querySelectorAll('[data-document-id]').forEach(function (row) {
                const id = (row.dataset.documentId || '').toLowerCase();
                if (id) rows.set(id, row);
            });
            if (rows.size === 0) return;

            const statusUrl = '@Url.Action("ScreeningStatus", "ApplicationDocuments", new { applicationId = Model.Id })';
            const tones = {
                Queued: 'text-muted',
                Scanning: 'text-primary',
                Passed: 'text-success',
                Flagged: 'text-warning-emphasis',
                Failed: 'text-warning-emphasis'
            };
            const startedAt = Date.now();
            let failures = 0;

            function apply(documents) {
                documents.forEach(function (d) {
                    const row = rows.get(String(d.id).toLowerCase());
                    if (!row) return;

                    const line = row.querySelector('[data-screening]');
                    const busy = d.status === 'Queued' || d.status === 'Scanning';

                    row.classList.toggle('is-checking', busy && !row.classList.contains('is-uploading'));

                    if (d.status === 'NotStarted') {
                        line.textContent = '';
                        return;
                    }
                    line.className = 'small ' + (tones[d.status] || 'text-muted');
                    line.setAttribute('data-screening', '');
                    line.textContent = d.message;
                });
            }

            async function poll() {
                try {
                    const res = await fetch(statusUrl, {
                        headers: { 'Accept': 'application/json' },
                        credentials: 'same-origin'
                    });
                    if (!res.ok) throw new Error('HTTP ' + res.status);

                    const data = await res.json();
                    failures = 0;
                    apply(data.documents);

                    if (data.done) return;
                } catch (e) {
                    failures++;
                    if (failures >= 3) return;   // stay quiet: the page still works without live status
                }

                if (Date.now() - startedAt > 180000) return;
                setTimeout(poll, 2000);
            }

            poll();
        })();
    </script>
}