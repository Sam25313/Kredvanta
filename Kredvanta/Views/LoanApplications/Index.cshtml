@using static Kredvanta.Models.Enums.LendingEnums
@model Kredvanta.ViewModels.LoanApplications.LoanApplicationIndexViewModel

@{
    ViewData["Title"] = "My Loan Applications";
    Layout = "_Layout";

    string GetStatusClass(LoanApplicationStatus status)
    {
        return status switch
        {
            LoanApplicationStatus.Draft => "bg-secondary-subtle text-secondary",
            LoanApplicationStatus.Submitted => "bg-primary-subtle text-primary",
            LoanApplicationStatus.UnderReview => "bg-info-subtle text-info-emphasis",
            LoanApplicationStatus.DocumentsRequired => "bg-warning-subtle text-warning-emphasis",
            LoanApplicationStatus.Recommended => "bg-info-subtle text-info-emphasis",
            LoanApplicationStatus.Approved => "bg-success-subtle text-success",
            LoanApplicationStatus.Rejected => "bg-danger-subtle text-danger",
            LoanApplicationStatus.Cancelled => "bg-dark-subtle text-dark",
            _ => "bg-secondary-subtle text-secondary"
        };
    }

    string GetStatusDescription(LoanApplicationStatus status)
    {
        return status switch
        {
            LoanApplicationStatus.Draft => "Application not yet submitted",
            LoanApplicationStatus.Submitted => "Awaiting initial review",
            LoanApplicationStatus.UnderReview => "Being reviewed by our team",
            LoanApplicationStatus.DocumentsRequired => "Additional documents required",
            LoanApplicationStatus.Recommended => "Recommended for approval",
            LoanApplicationStatus.Approved => "Application approved",
            LoanApplicationStatus.Rejected => "Application unsuccessful",
            LoanApplicationStatus.Cancelled => "Application cancelled",
            _ => "Status unavailable"
        };
    }
}

<div class="container-fluid py-4">

    <!-- Page heading -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">My Loan Applications</h2>
            <p class="text-muted mb-0">
                Track your loan requests and monitor their progress.
            </p>
        </div>

        <a asp-controller="LoanApplications"
           asp-action="Create"
           class="btn btn-primary px-4">
            <i class="bi bi-plus-circle me-2"></i>
            New Application
        </a>
    </div>

    <!-- Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Application summary cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Total Applications</p>
                            <h3 class="fw-bold mb-0">@Model.TotalApplications</h3>
                        </div>
                        <div class="rounded-3 bg-primary-subtle text-primary p-3">
                            <i class="bi bi-folder2-open fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Pending Review</p>
                            <h3 class="fw-bold mb-0">@Model.PendingApplications</h3>
                        </div>
                        <div class="rounded-3 bg-warning-subtle text-warning p-3">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Approved</p>
                            <h3 class="fw-bold mb-0">@Model.ApprovedApplications</h3>
                        </div>
                        <div class="rounded-3 bg-success-subtle text-success p-3">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Rejected</p>
                            <h3 class="fw-bold mb-0">@Model.RejectedApplications</h3>
                        </div>
                        <div class="rounded-3 bg-danger-subtle text-danger p-3">
                            <i class="bi bi-x-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Applications table -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1">Application History</h5>
                    <p class="text-muted small mb-0">
                        All your loan applications in one place.
                    </p>
                </div>

                <span class="badge bg-light text-dark border">
                    @Model.TotalApplications Records
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (Model.Applications.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Application</th>
                                <th>Loan Product</th>
                                <th>Requested Amount</th>
                                <th>Term</th>
                                <th>Status</th>
                                <th>Date Created</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var application in Model.Applications)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">
                                            @application.ApplicationNumber
                                        </div>
                                        <small class="text-muted">
                                            @application.LoanPurpose
                                        </small>
                                    </td>

                                    <td>
                                        @application.LoanProductName
                                    </td>

                                    <td class="fw-semibold">
                                        KSh @application.RequestedAmount.ToString("N2")
                                    </td>

                                    <td>
                                        @application.RequestedTermPeriods periods
                                    </td>

                                    <td>
                                        <span class="badge rounded-pill @GetStatusClass(application.Status)">
                                            @application.Status
                                        </span>
                                        <div class="small text-muted mt-1">
                                            @GetStatusDescription(application.Status)
                                        </div>
                                    </td>

                                    <td>
                                        @application.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>

                                    <td class="text-end pe-4">
                                        <a asp-controller="LoanApplications"
                                           asp-action="Details"
                                           asp-route-id="@application.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            View Details
                                            <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 px-3">
                    <div class="mb-3">
                        <i class="bi bi-file-earmark-text display-3 text-muted"></i>
                    </div>

                    <h5 class="fw-bold">No loan applications yet</h5>

                    <p class="text-muted mx-auto" style="max-width: 450px;">
                        You haven't created any loan applications.
                        Explore our available loan products and submit
                        your first application when you're ready.
                    </p>

                    <a asp-controller="LoanApplications"
                       asp-action="Create"
                       class="btn btn-primary px-4">
                        <i class="bi bi-plus-circle me-2"></i>
                        Apply for a Loan
                    </a>
                </div>
            }

        </div>
    </div>

    <!-- Information note -->
    <div class="mt-4 p-3 rounded-3 bg-light border">
        <div class="d-flex gap-3">
            <i class="bi bi-info-circle text-primary fs-5"></i>
            <div>
                <h6 class="fw-semibold mb-1">Application tracking</h6>
                <p class="text-muted small mb-0">
                    Select View Details to see your application's status,
                    review history, and uploaded supporting documents.
                    Applications saved as drafts must be submitted before
                    they can be reviewed.
                </p>
            </div>
        </div>
    </div>

</div>
