@model Kredvanta.ViewModels.Credit.CreditPolicyDraftViewModel

@{
	ViewData["Title"] = "Create credit policy";
	Layout = "_StaffLayout";
}

<div class="container py-4" style="max-width: 900px;">
	<div class="mb-4">
		<span class="text-muted small">CREDIT GOVERNANCE</span>
		<h1 class="h2 fw-bold mb-1">Create policy version</h1>
		<p class="text-muted mb-0">Enter the organisation's approved internal settings. This saves an inactive draft; it does not change application assessments until activated.</p>
	</div>

	<form asp-action="Create" method="post" class="card border-0 shadow-sm rounded-4">
		<div asp-validation-summary="ModelOnly" class="alert alert-danger m-3"></div>
		<div class="card-body p-4">
			<div class="row g-3">
				<div class="col-12">
					<label asp-for="Name" class="form-label">Policy name</label>
					<input asp-for="Name" class="form-control" autocomplete="off" />
					<span asp-validation-for="Name" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="MaxDebtServiceRatio" class="form-label">Maximum debt service ratio</label>
					<input asp-for="MaxDebtServiceRatio" type="number" min="0.01" max="1" step="0.01" class="form-control" />
					<div class="form-text">Enter as a ratio, e.g. 0.50 for 50%.</div>
					<span asp-validation-for="MaxDebtServiceRatio" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="MinNetMonthlyIncome" class="form-label">Minimum net monthly income (KES)</label>
					<input asp-for="MinNetMonthlyIncome" type="number" min="0" step="0.01" class="form-control" />
					<span asp-validation-for="MinNetMonthlyIncome" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="MinDisposableAfterInstalment" class="form-label">Minimum disposable income after instalment (KES)</label>
					<input asp-for="MinDisposableAfterInstalment" type="number" min="0" step="0.01" class="form-control" />
					<span asp-validation-for="MinDisposableAfterInstalment" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="DualApprovalAbove" class="form-label">Dual-approval threshold (KES, optional)</label>
					<input asp-for="DualApprovalAbove" type="number" min="0.01" step="0.01" class="form-control" />
					<div class="form-text">Requests above this amount require a second, different credit manager.</div>
					<span asp-validation-for="DualApprovalAbove" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="EffectiveFrom" class="form-label">Effective from</label>
					<input asp-for="EffectiveFrom" type="date" class="form-control" />
					<span asp-validation-for="EffectiveFrom" class="text-danger"></span>
				</div>
				<div class="col-md-6">
					<label asp-for="CalculationVersion" class="form-label">Calculation version</label>
					<input asp-for="CalculationVersion" class="form-control" />
					<span asp-validation-for="CalculationVersion" class="text-danger"></span>
				</div>
				<div class="col-12">
					<label asp-for="Notes" class="form-label">Approval / implementation notes</label>
					<textarea asp-for="Notes" rows="4" class="form-control"></textarea>
					<span asp-validation-for="Notes" class="text-danger"></span>
				</div>
			</div>
		</div>
		<div class="card-footer bg-white border-0 p-4 d-flex justify-content-between">
			<a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
			<button type="submit" class="btn btn-primary">Save inactive draft</button>
		</div>
	</form>
</div>
