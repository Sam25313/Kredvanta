@using static Kredvanta.Models.Enums.LendingEnums
@model List<Kredvanta.ViewModels.Staff.StaffApplicationListItem>

@{
    ViewData["Title"] = "Application Queue";
    //Layout = User.IsInRole("Administrator") ? "_AdminLayout" : "_Layout";
    var current = ViewBag.StatusFilter as LoanApplicationStatus?;
}
@{
    Layout = "_StaffLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1">Application Queue</h2>
            <p class="text-muted mb-0">Oldest submissions first.</p>
        </div>

        <form method="get" class="d-flex gap-2">
            <select name="status" class="form-select"
                    asp-items="Html.GetEnumSelectList<LoanApplicationStatus>()">
                <option value="">All statuses</option>
            </select>
            <button class="btn btn-outline-primary">Filter</button>
        </form>
    </div>

    @foreach (var (key, css) in new[] { ("Success", "success"), ("Error", "danger"), ("Warning", "warning") })
    {
        if (TempData[key] != null)
        {
            <div class="alert alert-@css alert-dismissible fade show">
                @TempData[key]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Application</th>
                        <th>Applicant</th>
                        <th>Product</th>
                        <th>Amount (KES)</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Docs to review</th>
                        <th class="pe-4"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@a.ApplicationNumber</td>
                            <td>@a.BorrowerName</td>
                            <td>@a.ProductName</td>
                            <td>@a.RequestedAmount.ToString("N2")</td>
                            <td><span class="badge bg-secondary">@a.Status</span></td>
                            <td>@(a.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                            <td>@(a.PendingDocuments > 0 ? a.PendingDocuments.ToString() : "—")</td>
                            <td class="pe-4">
                                <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@a.Id">Open</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-5">No applications found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>