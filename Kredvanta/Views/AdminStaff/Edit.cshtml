@model Kredvanta.ViewModels.Staff.EditStaffViewModel
@{
    ViewData["Title"] = "Change roles"; Layout = "_AdminLayout";
}

<div class="container py-4" style="max-width: 720px;">
    <h2 class="fw-bold mb-1">Change roles</h2>
    <p class="text-muted">@Model.Name, @Model.Email</p>

    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger">@err</div>
    }

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card border-0 shadow-sm">
        <div class="card-body">
            <partial name="_PresetPicker" model="Model.Presets" />
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Cancel</a>
                <button class="btn btn-primary">Save roles</button>
            </div>
        </div>
    </form>
</div>