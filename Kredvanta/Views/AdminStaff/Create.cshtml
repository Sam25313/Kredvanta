@model Kredvanta.ViewModels.Staff.CreateStaffViewModel
@{
    ViewData["Title"] = "Add staff member"; Layout = "_AdminLayout";
}

<div class="container py-4" style="max-width: 720px;">
    <h2 class="fw-bold mb-3">Add staff member</h2>

    <form asp-action="Create" method="post" class="card border-0 shadow-sm">
        <div class="card-body">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Role</label>
                    <partial name="_PresetPicker" model="Model.Presets" />
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-light border">Cancel</a>
                <button class="btn btn-primary">Create account</button>
            </div>
        </div>
    </form>
</div>