@model List<Kredvanta.Controllers.StaffDecisionsController.DecisionRow>
@{
    ViewData["Title"] = "Decisions";
}
<h2 class="fw-bold mb-1">Decisions</h2>
<p class="text-muted">Applications recommended by an analyst and waiting for you.</p>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Application</th>
                    <th>Borrower</th>
                    <th>Product</th>
                    <th>Amount (KES)</th>
                    <th>Approvals so far</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="ps-3 fw-semibold">@r.Number</td>
                        <td>@r.Borrower</td>
                        <td>@r.Product</td>
                        <td>@r.Amount.ToString("N2")</td>
                        <td>@r.Approvals</td>
                        <td class="pe-3"><a class="btn btn-sm btn-primary" asp-controller="StaffDecisions" asp-action="Case" asp-route-id="@r.Id">Review</a></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-check-circle me-1"></i>Nothing waiting for a decision.</td></tr>
                }
            </tbody>        </table>
        </div>
    </div>