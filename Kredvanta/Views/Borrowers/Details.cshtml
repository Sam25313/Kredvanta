@model Kredvanta.Models.Borrowers.Borrower

@{
    ViewData["Title"] = "Applicant Details";
    var fullName = $"{Model.FirstName} {Model.MiddleName} {Model.LastName}".Replace("  ", " ").Trim();
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Applicant Details</h3>
            <p class="text-muted mb-0">
                View and manage applicant information.
            </p>
        </div>

        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Back to Applicants
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Edit Applicant
            </a>
        </div>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- Applicant Profile Summary -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">

                    <div class="rounded-circle bg-primary bg-opacity-10
                        text-primary d-flex align-items-center
                        justify-content-center mx-auto mb-3"
                         style="width: 85px; height: 85px; font-size: 32px;">
                        <i class="bi bi-person"></i>
                    </div>

                    <h4 class="fw-bold mb-1">@fullName</h4>

                    <p class="text-muted mb-3">
                        @Model.BorrowerNumber
                    </p>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success px-3 py-2">
                            Active Account
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger px-3 py-2">
                            Inactive Account
                        </span>
                    }

                    <hr class="my-4" />

                    <div class="text-start">
                        <div class="mb-3">
                            <small class="text-muted d-block">KYC Status</small>
                            <strong>@Model.KycStatus</strong>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block">Registration Date</small>
                            <strong>@Model.CreatedAt.ToString("dd MMM yyyy")</strong>
                        </div>

                        <div>
                            <small class="text-muted d-block">Last Updated</small>
                            <strong>
                                @(Model.UpdatedAt.HasValue
                                    ? Model.UpdatedAt.Value.ToString("dd MMM yyyy")
                                    : "Not updated")
                            </strong>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Applicant Information -->
        <div class="col-lg-8">

            <!-- Personal Information -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person-vcard text-primary me-2"></i>
                        Personal Information
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <small class="text-muted d-block">First Name</small>
                            <strong>@Model.FirstName</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Middle Name</small>
                            <strong>@(Model.MiddleName ?? "Not provided")</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Last Name</small>
                            <strong>@Model.LastName</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Date of Birth</small>
                            <strong>@Model.DateOfBirth.ToString("dd MMMM yyyy")</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Gender</small>
                            <strong>@Model.Gender</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">National ID Number</small>
                            <strong>@Model.NationalIdNumber</strong>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-telephone text-primary me-2"></i>
                        Contact Information
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <small class="text-muted d-block">Primary Phone</small>
                            <strong>@Model.PhoneNumber</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Alternative Phone</small>
                            <strong>
                                @(Model.AlternativePhoneNumber ?? "Not provided")
                            </strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Email Address</small>
                            <strong>@(Model.Email ?? "Not provided")</strong>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Location Information -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-geo-alt text-primary me-2"></i>
                        Location Information
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <small class="text-muted d-block">County</small>
                            <strong>@Model.County</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Sub-County</small>
                            <strong>@(Model.SubCounty ?? "Not provided")</strong>
                        </div>

                        <div class="col-12">
                            <small class="text-muted d-block">Physical Address</small>
                            <strong>
                                @(Model.PhysicalAddress ?? "Not provided")
                            </strong>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Employment and Financial Information -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-briefcase text-primary me-2"></i>
                        Employment and Income
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <small class="text-muted d-block">Employment Type</small>
                            <strong>@Model.EmploymentType</strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Employer / Business</small>
                            <strong>
                                @(Model.EmployerOrBusinessName ?? "Not provided")
                            </strong>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted d-block">Monthly Income</small>
                            <strong>
                                @(Model.MonthlyIncome.HasValue
                                    ? Model.MonthlyIncome.Value.ToString("N2")
                                    : "Not provided")
                                @(Model.MonthlyIncome.HasValue ? " KES" : "")
                            </strong>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Account Management -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-gear text-primary me-2"></i>
                        Account Management
                    </h5>
                </div>

                <div class="card-body">

                    <p class="text-muted">
                        Deactivating an applicant prevents the account from
                        being treated as active. It does not delete the
                        applicant's records.
                    </p>

                    @if (Model.IsActive)
                    {
                        <form asp-action="Deactivate"
                              asp-route-id="@Model.Id"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to deactivate this applicant?');">

                            <button type="submit" class="btn btn-outline-danger">
                                <i class="bi bi-person-x me-1"></i>
                                Deactivate Applicant
                            </button>

                        </form>
                    }
                    else
                    {
                        <span class="text-danger fw-semibold">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            This applicant account is inactive.
                        </span>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
