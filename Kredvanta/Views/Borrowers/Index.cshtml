@model List<Kredvanta.Models.Borrowers.Borrower>

@{
    ViewData["Title"] = "Applicants";
    Layout = "_AdminLayout";

    var search = ViewBag.Search as string ?? string.Empty;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalRecords = (int)ViewBag.TotalRecords;
}

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-primary fw-semibold small">ADMINISTRATION</span>
            <h2 class="fw-bold mb-1">Applicants</h2>
            <p class="text-muted mb-0">View applicant profiles, contact details and verification status.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-2"></i>Register Applicant
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-3 px-3 px-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <h5 class="fw-bold mb-0">Applicant directory</h5>
                <span class="badge bg-primary-subtle text-primary">@totalRecords applicant(s)</span>
            </div>
            <form asp-action="Index" method="get" class="row g-2 mt-2">
                <div class="col-sm-8 col-lg-5">
                    <label class="visually-hidden" for="applicantSearch">Search applicants</label>
                    <input id="applicantSearch" name="search" value="@search" class="form-control"
                           placeholder="Search name, email, phone or ID number" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search me-1"></i>Search
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <div class="col-auto">
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    </div>
                }
            </form>
        </div>

        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-person-vcard display-6 text-muted"></i>
                    <h5 class="mt-3">@(string.IsNullOrWhiteSpace(search) ? "No applicants yet" : "No applicants found")</h5>
                    <p class="text-muted mb-0">
                        @(string.IsNullOrWhiteSpace(search)
                            ? "Applicant profiles will appear here once they register."
                            : "Try another name, email address, phone number or identification number.")
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 ps-lg-4">Applicant</th>
                                <th>Contact</th>
                                <th>Identification</th>
                                <th>Profile</th>
                                <th>Verification</th>
                                <th>Account</th>
                                <th class="text-end pe-3 pe-lg-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var applicant in Model)
                            {
                                var fullName = string.Join(" ", new[]
                                {
                                    applicant.FirstName,
                                    applicant.MiddleName,
                                    applicant.LastName
                                }.Where(part => !string.IsNullOrWhiteSpace(part)));

                                <tr>
                                    <td class="ps-3 ps-lg-4">
                                        <div class="fw-semibold">@fullName</div>
                                        <div class="small text-muted">@applicant.BorrowerNumber</div>
                                    </td>
                                    <td>
                                        <div>@(string.IsNullOrWhiteSpace(applicant.Email) ? "No email provided" : applicant.Email)</div>
                                        <div class="small text-muted">@applicant.PhoneNumber</div>
                                    </td>
                                    <td>
                                        <div>@applicant.IdentificationType</div>
                                        <div class="small text-muted">@applicant.NationalIdNumber</div>
                                    </td>
                                    <td>
                                        @if (applicant.IsProfileComplete)
                                        {
                                            <span class="badge bg-success-subtle text-success">Complete</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis">In progress</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (applicant.KycStatus)
                                        {
                                            case Kredvanta.Models.Enums.LendingEnums.KycStatus.Verified:
                                                <span class="badge bg-success-subtle text-success">Verified</span>
                                                break;
                                            case Kredvanta.Models.Enums.LendingEnums.KycStatus.Pending:
                                                <span class="badge bg-primary-subtle text-primary">Pending</span>
                                                break;
                                            case Kredvanta.Models.Enums.LendingEnums.KycStatus.Rejected:
                                                <span class="badge bg-danger-subtle text-danger">Rejected</span>
                                                break;
                                            case Kredvanta.Models.Enums.LendingEnums.KycStatus.Escalated:
                                                <span class="badge bg-warning-subtle text-warning-emphasis">Escalated</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary-subtle text-secondary">Not started</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (applicant.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3 pe-lg-4">
                                        <a asp-action="Details" asp-route-id="@applicant.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <nav class="px-3 px-lg-4 py-3" aria-label="Applicant list pages">
                        <ul class="pagination justify-content-end mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(currentPage - 1)" aria-label="Previous page">Previous</a>
                            </li>
                            @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                            {
                                <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@pageNumber" aria-current="@(pageNumber == currentPage ? "page" : null)">@pageNumber</a>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(currentPage + 1)" aria-label="Next page">Next</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
