@model Kredvanta.ViewModels.Profile.CreateProfileViewModel

@{
    ViewData["Title"] = "Contact & Residence Details";
    ViewData["CurrentStep"] = 2;
    Layout = "_Layout";
}

<style>
    .onboarding-container {
        max-width: 1050px;
        margin: 35px auto;
        padding: 0 15px;
    }

    .onboarding-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15, 23, 42, .05);
    }

    .onboarding-header {
        background: linear-gradient(120deg, #14532d, #166534);
        color: #fff;
        padding: 28px 32px;
    }

        .onboarding-header h2 {
            font-size: 23px;
            font-weight: 700;
            margin-bottom: 7px;
        }

        .onboarding-header p {
            color: #cbd5e1;
            margin: 0;
            font-size: 14px;
        }

    .onboarding-body {
        padding: 30px 32px;
    }

    .section-heading {
        font-size: 15px;
        font-weight: 700;
        color: #166534;
        margin: 24px 0 17px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e2e8f0;
    }

        .section-heading:first-child {
            margin-top: 0;
        }

    .form-label {
        font-size: 13px;
        font-weight: 650;
        color: #334155;
        margin-bottom: 7px;
    }

    .form-control, .form-select {
        min-height: 45px;
        border-radius: 8px;
        border-color: #cbd5e1;
        font-size: 14px;
    }

    textarea.form-control {
        min-height: 95px;
    }

    .form-control:focus, .form-select:focus {
        border-color: #166534;
        box-shadow: 0 0 0 3px rgba(22, 101, 52, .12);
    }

    .field-hint {
        color: #64748b;
        font-size: 11px;
        margin-top: 5px;
    }

    .btn-primary-custom {
        background: #166534;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 11px 24px;
        font-size: 14px;
        font-weight: 650;
    }

        .btn-primary-custom:hover {
            background: #14532d;
            color: #fff;
        }

    .btn-secondary-custom {
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 11px 24px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-secondary-custom:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

    .information-note {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 9px;
        padding: 14px 16px;
        color: #14532d;
        font-size: 13px;
        margin-top: 25px;
    }

    @@media (max-width: 600px) {
        .onboarding-header, .onboarding-body {
            padding: 22px 18px;
        }
    }
</style>

<div class="onboarding-container">

    <partial name="_ProfileProgress" />

    <div class="onboarding-card">

        <div class="onboarding-header">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-geo-alt fs-4"></i>
                <span class="small text-uppercase fw-semibold">
                    Applicant Profile Registration
                </span>
            </div>

            <h2>Contact & Residence Details</h2>

            <p>
                Your phone number and email are taken from your account. Provide your current residential address below.
            </p>
        </div>

        <div class="onboarding-body">

            <form asp-controller="Profile"
                  asp-action="Step2"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert"></div>

                <h5 class="section-heading">
                    <i class="bi bi-telephone me-2"></i>
                    Contact Information
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label">
                            Primary Phone Number <span class="text-danger">*</span>
                        </label>

                        <input id="PhoneNumber"
                               value="@Model.PhoneNumber"
                               class="form-control"
                               type="tel"
                               autocomplete="tel"
                               readonly />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger small"></span>

                      
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AlternativePhoneNumber"
                               class="form-label">
                            Alternative Phone Number
                        </label>

                        <input asp-for="AlternativePhoneNumber"
                               class="form-control"
                               type="tel"
                               placeholder="e.g. 0723456789" />

                        <span asp-validation-for="AlternativePhoneNumber"
                              class="text-danger small"></span>

                        <div class="field-hint">
                            Optional. Provide another reachable number.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">
                            Email Address <span class="text-danger">*</span>
                        </label>

                        <input id="Email"
                               value="@Model.Email"
                               class="form-control"
                               type="email"
                               autocomplete="email"
                               readonly />

                        <span asp-validation-for="Email"
                              class="text-danger small"></span>

                        @* <div class="field-hint">
                            Saved from your account. <a asp-area="Identity" asp-page="/Account/Manage/Index">Update it in account settings</a> if needed.
                        </div> *@
                    </div>

                </div>

                <h5 class="section-heading">
                    <i class="bi bi-house-door me-2"></i>
                    Residential Information
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="County" class="form-label">
                            County <span class="text-danger">*</span>
                        </label>

                        <select asp-for="County" class="form-select" disabled>
                            <option value="">Loading counties...</option>
                        </select>

                        <span asp-validation-for="County"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SubCounty" class="form-label">
                            Sub-County <span class="text-danger">*</span>
                        </label>

                        <select asp-for="SubCounty" class="form-select" disabled>
                            <option value="">Select a county first</option>
                        </select>

                        <span asp-validation-for="SubCounty"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Ward" class="form-label">
                            Ward <span class="text-danger">*</span>
                        </label>

                        <select asp-for="Ward" class="form-select" disabled>
                            <option value="">Select a sub-county first</option>
                        </select>

                        <span asp-validation-for="Ward"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EstateOrVillage" class="form-label">
                            Estate / Village <span class="text-danger">*</span>
                        </label>

                        <input asp-for="EstateOrVillage"
                               class="form-control"
                               placeholder="Enter your estate or village" />

                        <span asp-validation-for="EstateOrVillage"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ResidenceType" class="form-label">
                            Residence Type <span class="text-danger">*</span>
                        </label>

                        <select asp-for="ResidenceType"
                                class="form-select"
                                asp-items="Html.GetEnumSelectList<Kredvanta.Models.Enums.ResidenceType>()">
                            <option value="">Select residence type</option>
                        </select>

                        <span asp-validation-for="ResidenceType"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="PhysicalAddress" class="form-label">
                            Physical Address <span class="text-danger">*</span>
                        </label>

                        <textarea asp-for="PhysicalAddress"
                                  class="form-control"
                                  placeholder="Provide directions or a more specific description of your residential location."></textarea>

                        <span asp-validation-for="PhysicalAddress"
                              class="text-danger small"></span>

                       
                    </div>

                </div>

                <div id="kenya-location-data"
                     data-url="@Url.Content("~/data/kenya-locations.json")"
                     data-county="@Model.County"
                     data-sub-county="@Model.SubCounty"
                     data-ward="@Model.Ward"
                     class="visually-hidden"></div>

                <div id="location-load-error" class="alert alert-danger d-none" role="alert"></div>

                

                <div class="information-note">
                    <i class="bi bi-shield-check me-2"></i>
                    Your contact and residential information will be handled
                    securely and used for legitimate account administration,
                    communication and lending assessment purposes.
                </div>

                <div class="d-flex justify-content-between align-items-center
                    flex-wrap gap-3 mt-4 pt-3 border-top">

                    <a asp-controller="Profile"
                       asp-action="Step1"
                       class="btn-secondary-custom">
                        <i class="bi bi-arrow-left me-1"></i>
                        Back
                    </a>

                    <button id="step2-submit" type="submit" class="btn-primary-custom" disabled>
                        Save & Continue
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (async function () {
            const dataElement = document.getElementById("kenya-location-data");
            const countySelect = document.getElementById("County");
            const subCountySelect = document.getElementById("SubCounty");
            const wardSelect = document.getElementById("Ward");
            const submitButton = document.getElementById("step2-submit");
            const errorElement = document.getElementById("location-load-error");

            function populate(select, items, placeholder, selectedValue) {
                select.replaceChildren(new Option(placeholder, ""));
                for (const item of items) {
                    const name = typeof item === "string" ? item : item.name;
                    select.add(new Option(name, name));
                }
                if (selectedValue && Array.from(select.options).some(option => option.value === selectedValue)) {
                    select.value = selectedValue;
                }
            }

            try {
                const response = await fetch(dataElement.dataset.url);
                if (!response.ok) {
                    throw new Error(`Location data request failed with status ${response.status}.`);
                }

                const data = await response.json();
                if (!Array.isArray(data.counties) || data.counties.length === 0) {
                    throw new Error("Location data does not contain any counties.");
                }

                const counties = data.counties;
                const selectedCounty = dataElement.dataset.county;
                const selectedSubCounty = dataElement.dataset.subCounty;
                const selectedWard = dataElement.dataset.ward;

                function updateWards(selectedValue = "") {
                    const county = counties.find(item => item.name === countySelect.value);
                    const subCounty = county?.subCounties.find(item => item.name === subCountySelect.value);
                    populate(wardSelect, subCounty ? subCounty.wards : [], "Select a ward", selectedValue);
                    wardSelect.disabled = !subCounty;
                }

                function updateSubCounties(selectedValue = "") {
                    const county = counties.find(item => item.name === countySelect.value);
                    populate(subCountySelect, county ? county.subCounties : [], "Select a sub-county", selectedValue);
                    subCountySelect.disabled = !county;
                    updateWards();
                }

                populate(countySelect, counties, "Select a county", selectedCounty);
                countySelect.disabled = false;
                updateSubCounties(selectedSubCounty);
                updateWards(selectedWard);

                countySelect.addEventListener("change", () => updateSubCounties());
                subCountySelect.addEventListener("change", () => updateWards());
                submitButton.disabled = false;
            } catch (error) {
                console.error("Unable to load Kenya location options.", error);
                errorElement.textContent = "County and sub-county options could not be loaded. Please refresh the page or try again later.";
                errorElement.classList.remove("d-none");
                countySelect.disabled = true;
                subCountySelect.disabled = true;
                wardSelect.disabled = true;
                submitButton.disabled = true;
            }
        })();
    </script>
}
