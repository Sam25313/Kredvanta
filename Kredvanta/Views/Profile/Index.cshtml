@model Kredvanta.Models.Borrowers.Borrower

@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<style>
    .borrower-profile-page {
        background: #F1F5F9;
        min-height: 100vh;
        padding: 40px 0 65px;
    }

    .borrower-profile-card {
        background: white;
        border: 1px solid #E2E8F0;
        border-radius: 15px;
        padding: 25px;
        height: 100%;
    }

        .borrower-profile-card h5 {
            color: #0F172A;
            font-size: 15px;
            font-weight: 750;
            margin-bottom: 20px;
        }

    .profile-detail {
        margin-bottom: 19px;
    }

        .profile-detail small {
            display: block;
            color: #64748B;
            font-size: 11px;
            margin-bottom: 5px;
        }

        .profile-detail strong {
            color: #0F172A;
            font-size: 13px;
            font-weight: 650;
            overflow-wrap: anywhere;
        }

    .profile-page-heading h2 {
        color: #0F172A;
        font-weight: 800;
    }

    .profile-page-heading p {
        color: #64748B;
        font-size: 13px;
    }

    .profile-edit-button {
        background: #0F766E;
        color: white;
        border-radius: 9px;
        padding: 10px 18px;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
    }

        .profile-edit-button:hover {
            background: #115E59;
            color: white;
        }

    .profile-status {
        background: #CCFBF1;
        color: #0F766E;
        border-radius: 20px;
        padding: 7px 12px;
        font-size: 11px;
        font-weight: 750;
    }
</style>

<div class="borrower-profile-page">
    <div class="container">

        <div class="d-flex flex-column flex-md-row
            justify-content-between align-items-md-center gap-3 mb-4">

            <div class="profile-page-heading">
                <h2 class="mb-1">My Applicant Profile</h2>
                <p class="mb-0">
                    Review your personal and employment information.
                </p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="profile-status">
                    KYC: @Model.KycStatus
                </span>

                <a asp-controller="Profile"
                   asp-action="Edit"
                   class="profile-edit-button">
                    <i class="bi bi-pencil-square me-1"></i>
                    Edit Profile
                </a>
            </div>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-2"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="row g-4">

            <!-- PERSONAL INFORMATION -->
            <div class="col-lg-6">
                <div class="borrower-profile-card">

                    <h5>
                        <i class="bi bi-person me-2"
                           style="color:#0F766E"></i>
                        Personal Information
                    </h5>

                    <div class="profile-detail">
                        <small>Applicant Number</small>
                        <strong>@Model.BorrowerNumber</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Full Name</small>
                        <strong>
                            @Model.FirstName @Model.MiddleName @Model.LastName
                        </strong>
                    </div>

                    <div class="profile-detail">
                        <small>National ID Number</small>
                        <strong>@Model.NationalIdNumber</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Date of Birth</small>
                        <strong>@Model.DateOfBirth.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Gender</small>
                        <strong>@Model.Gender</strong>
                    </div>

                </div>
            </div>

            <!-- CONTACT AND RESIDENCE -->
            <div class="col-lg-6">
                <div class="borrower-profile-card">

                    <h5>
                        <i class="bi bi-telephone me-2"
                           style="color:#0F766E"></i>
                        Contact and Residence
                    </h5>

                    <div class="profile-detail">
                        <small>Phone Number</small>
                        <strong>@Model.PhoneNumber</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Alternative Phone</small>
                        <strong>@(Model.AlternativePhoneNumber ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Email</small>
                        <strong>@(Model.Email ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>County</small>
                        <strong>@Model.County</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Sub-County</small>
                        <strong>@(Model.SubCounty ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Physical Address</small>
                        <strong>@(Model.PhysicalAddress ?? "Not provided")</strong>
                    </div>

                </div>
            </div>

            <!-- EMPLOYMENT -->
            <div class="col-lg-6">
                <div class="borrower-profile-card">

                    <h5>
                        <i class="bi bi-briefcase me-2"
                           style="color:#0F766E"></i>
                        Employment Information
                    </h5>

                    <div class="profile-detail">
                        <small>Employment Type</small>
                        <strong>@Model.EmploymentType</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Employer / Business</small>
                        <strong>@(Model.EmployerOrBusinessName ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Job Title</small>
                        <strong>@(Model.JobTitle ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Contract Type</small>
                        <strong>@(Model.EmploymentContractType?.ToString() ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Employment Start Date</small>
                        <strong>
                            @(Model.EmploymentStartDate?.ToString("dd MMM yyyy") ?? "Not provided")
                        </strong>
                    </div>

                    <div class="profile-detail">
                        <small>Employment End Date</small>
                        <strong>
                            @(Model.EmploymentEndDate?.ToString("dd MMM yyyy") ?? "Not provided")
                        </strong>
                    </div>

                    <div class="profile-detail">
                        <small>Probation End Date</small>
                        <strong>
                            @(Model.ProbationEndDate?.ToString("dd MMM yyyy") ?? "Not provided")
                        </strong>
                    </div>

                </div>
            </div>

            <!-- EMPLOYER AND SALARY -->
            <div class="col-lg-6">
                <div class="borrower-profile-card">

                    <h5>
                        <i class="bi bi-cash-stack me-2"
                           style="color:#0F766E"></i>
                        Employer and Income
                    </h5>

                    <div class="profile-detail">
                        <small>Employer Contact Person</small>
                        <strong>@(Model.EmployerContactPerson ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Employer Phone</small>
                        <strong>@(Model.EmployerPhoneNumber ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Employer Email</small>
                        <strong>@(Model.EmployerEmail ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Employer Address</small>
                        <strong>@(Model.EmployerAddress ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Gross Monthly Salary</small>
                        <strong>
                            @(Model.GrossMonthlySalary.HasValue
                                ? $"KES {Model.GrossMonthlySalary.Value:N2}"
                                : "Not provided")
                        </strong>
                    </div>

                    <div class="profile-detail">
                        <small>Net Monthly Salary</small>
                        <strong>
                            @(Model.NetMonthlySalary.HasValue
                                ? $"KES {Model.NetMonthlySalary.Value:N2}"
                                : "Not provided")
                        </strong>
                    </div>

                    <div class="profile-detail">
                        <small>Payroll Frequency</small>
                        <strong>@(Model.PayrollFrequency?.ToString() ?? "Not provided")</strong>
                    </div>

                    <div class="profile-detail">
                        <small>Monthly Income (legacy field)</small>
                        <strong>
                            @(Model.MonthlyIncome.HasValue
                                ? $"KES {Model.MonthlyIncome.Value:N2}"
                                : "Not provided")
                        </strong>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>
