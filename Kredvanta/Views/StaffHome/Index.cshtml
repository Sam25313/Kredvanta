@model Kredvanta.ViewModels.Staff.StaffHomeViewModel
@{
    ViewData["Title"] = "My work";
}

<h2 class="fw-bold mb-1">My work</h2>
<p class="text-muted">What needs doing today, in the order a loan moves through the process.</p>

@if (!Model.Cards.Any())
{
    <div class="alert alert-light border">There are no queues for your role.</div>
}

<div class="row g-3">
    @foreach (var c in Model.Cards)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start">
                        <h6 class="fw-bold mb-1">@c.Title</h6>
                        <span class="badge @(c.Count > 0 ? "bg-primary" : "bg-light text-muted border")">@c.Count</span>
                    </div>
                    <p class="small text-muted flex-grow-1">@c.Hint</p>
                    @if (c.Count == 0 && c.ShowAllClear)
                    {
                        <div class="small text-success mb-2"><i class="bi bi-check-circle me-1"></i>Nothing waiting</div>
                    }
                    <a class="btn btn-sm @(c.Count > 0 ? "btn-primary" : "btn-outline-secondary")" href="@c.Url">Open</a>
                </div>
            </div>
        </div>
    }
</div>