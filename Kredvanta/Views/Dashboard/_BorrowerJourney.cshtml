@using Kredvanta.ViewModels.Dashboard
@using static Kredvanta.Models.Enums.LendingEnums
@model BorrowerJourneyViewModel

<!-- Journey tracker -->
<div class="dashboard-panel mb-4">
    <div class="panel-heading">
        <div>
            <h5 class="panel-title">Your loan journey</h5>
            <div class="panel-subtitle">Each step unlocks the next. A completed step does not guarantee approval.</div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @foreach (var s in Model.Steps)
        {
            var css = s.State == StepState.Done ? "status-success"
                    : s.State == StepState.Current ? "status-primary" : "status-secondary";
            var icon = s.State == StepState.Done ? "bi-check-circle-fill"
                     : s.State == StepState.Current ? "bi-arrow-right-circle-fill" : "bi-circle";
            <span class="status-badge @css"><i class="bi @icon me-1"></i>@s.Title</span>
        }
    </div>

    <div class="alert alert-@Model.NextAction.Css mt-3 mb-0 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <strong>@Model.NextAction.Title</strong>
            <div class="small">@Model.NextAction.Message</div>
        </div>

        @if (!string.IsNullOrEmpty(Model.NextAction.ButtonText))
        {
            @if (!string.IsNullOrEmpty(Model.NextAction.Anchor))
            {
                <a href="@Model.NextAction.Anchor" class="btn btn-sm btn-dark">@Model.NextAction.ButtonText</a>
            }
            else
            {
                <a asp-controller="@Model.NextAction.Controller" asp-action="@Model.NextAction.Action"
                   asp-route-id="@Model.NextAction.RouteId" class="btn btn-sm btn-dark">@Model.NextAction.ButtonText</a>
            }
        }
    </div>
</div>

<!-- Apply -->
@if (Model.CanStartApplication)
{
    <div class="dashboard-panel mb-4" id="apply">
        <div class="panel-heading">
            <div>
                <h5 class="panel-title">Apply for a loan</h5>
                <div class="panel-subtitle">Saving creates a draft. You can upload documents before submitting.</div>
            </div>
            <i class="bi bi-cash-coin text-primary fs-5"></i>
        </div>

        @if (!Model.Products.Any())
        {
            <div class="empty-state">
                <i class="bi bi-grid"></i>
                <h6>No products are open for applications</h6>
            </div>
        }
        else
        {
            <form asp-controller="LoanApplications" asp-action="Create" method="post" class="row g-3">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Loan product</label>
                    <select name="LoanProductId" id="dashProduct" class="form-select" required>
                        <option value="">Select a product</option>
                        @foreach (var p in Model.Products)
                        {
                            <option value="@p.Id"
                                    data-min="@p.MinimumAmount" data-max="@p.MaximumAmount"
                                    data-min-term="@p.MinimumTerm" data-max-term="@p.MaximumTerm"
                                    data-frequency="@p.Frequency" data-rate="@p.AnnualInterestRate"
                                    data-interest="@p.InterestMethod">@p.Name</option>
                        }
                    </select>
                    <div class="form-text" id="dashProductInfo">Select a product to see its limits.</div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Amount (KES)</label>
                    <input type="number" name="RequestedAmount" id="dashAmount" class="form-control"
                           min="1" step="0.01" required />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Term <span id="dashTermUnit" class="text-muted">(periods)</span></label>
                    <input type="number" name="RequestedTermPeriods" id="dashTerm" class="form-control"
                           min="1" max="120" required />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Purpose of the loan</label>
                    <textarea name="LoanPurpose" class="form-control" rows="3" maxlength="1000" required
                              placeholder="How will you use the funds?"></textarea>
                </div>

                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-2"></i>Save application draft
                    </button>
                </div>
            </form>
        }
    </div>
}

<!-- Current application -->
@if (Model.OpenApplication is { } app)
{
    <div class="dashboard-panel mb-4" id="documents">
        <div class="panel-heading">
            <div>
                <h5 class="panel-title">@app.Number</h5>
                <div class="panel-subtitle">
                    @app.ProductName · KES @app.Amount.ToString("N2") · @app.Term periods
                </div>
            </div>
            <span class="status-badge status-primary">
                @System.Text.RegularExpressions.Regex.Replace(app.Status.ToString(), "([a-z])([A-Z])", "$1 $2")
            </span>
        </div>

        <h6 class="fw-bold">Required documents</h6>
        <p class="small text-muted">PDF, PNG or JPG, up to 5 MB each. Uploading does not mean a document is accepted.</p>

        <div class="table-responsive">
            <table class="dashboard-table">
                <thead><tr><th>Document</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var d in app.Documents)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">
                                    @d.Name
                                    @if (d.IsMandatory)
                                    {
                                        <span class="status-badge status-danger ms-1">Required</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(d.Description))
                                {
                                    <div class="text-muted">@d.Description</div>
                                }
                                @if (d.IsUploaded)
                                {
                                    <div class="text-muted">Version @d.Version</div>
                                }
                            </td>
                            <td>
                                @if (!d.IsUploaded)
                                {
                                    <span class="status-badge status-secondary">Missing</span>
                                }
                                else if (d.ReviewStatus == DocumentReviewStatus.Verified)
                                {

                                    <span class="status-badge status-success">Accepted</span>
                                }
                                else if (d.ReviewStatus == DocumentReviewStatus.Rejected)
                                {

                                    <span class="status-badge status-danger">Rejected</span>
                                }
                                else if (d.ReviewStatus == DocumentReviewStatus.ClarificationRequired)
                                {

                                    <span class="status-badge status-info">More information needed</span>
                                }
                                else
                                {

                                    <span class="status-badge status-warning">Under review</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(d.Message))
                                {
                                    <div class="text-danger mt-1">@d.Message</div>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    @if (d.DocumentId.HasValue)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-controller="ApplicationDocuments" asp-action="Download"
                                           asp-route-applicationId="@app.Id" asp-route-documentId="@d.DocumentId">Download</a>
                                    }

                                    @if (app.CanUpload && d.ReviewStatus != DocumentReviewStatus.Verified)
                                    {
                                        <form asp-controller="ApplicationDocuments" asp-action="Upload"
                                              asp-route-applicationId="@app.Id" method="post"
                                              enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
                                            <input type="hidden" name="requiredDocumentId" value="@d.RequirementId" />
                                            <input type="hidden" name="returnTo" value="dashboard" />
                                            <input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg"
                                                   class="form-control form-control-sm" required />
                                            <button class="btn btn-sm btn-primary">@(d.IsUploaded ? "Replace" : "Upload")</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (app.Status is LoanApplicationStatus.Draft or LoanApplicationStatus.DocumentsRequired)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-3 border-top">
                <span class="small text-muted">
                    @(app.MissingMandatory > 0
                        ? $"{app.MissingMandatory} required document(s) still need to be uploaded or replaced."
                        : "All required documents are supplied and ready to submit.")
                </span>
                <form asp-controller="LoanApplications" asp-action="Submit" asp-route-id="@app.Id" method="post"
                      onsubmit="return confirm('Submit this application for verification?');">
                    <button class="btn btn-primary" @(app.CanSubmit ? "" : "disabled")>
                        <i class="bi bi-send me-1"></i>Submit for verification
                    </button>
                </form>
            </div>
        }

        <div class="mt-3">
            <a asp-controller="LoanApplications" asp-action="Details" asp-route-id="@app.Id" class="view-all-link">
                Full application details and history <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
}

<script>
    (function () {
        var select = document.getElementById("dashProduct");
        if (!select) return;

        var amount = document.getElementById("dashAmount");
        var term = document.getElementById("dashTerm");
        var info = document.getElementById("dashProductInfo");
        var unit = document.getElementById("dashTermUnit");

        function money(v) {
            return "KES " + Number(v).toLocaleString("en-KE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        select.addEventListener("change", function () {
            var o = select.options[select.selectedIndex];
            if (!o || !o.value) {
                info.textContent = "Select a product to see its limits.";
                return;
            }
            amount.min = o.dataset.min; amount.max = o.dataset.max;
            term.min = o.dataset.minTerm; term.max = o.dataset.maxTerm;
            unit.textContent = "(" + o.dataset.frequency + ")";
            info.textContent = "Amount " + money(o.dataset.min) + " to " + money(o.dataset.max) +
                ", term " + o.dataset.minTerm + " to " + o.dataset.maxTerm + " " + o.dataset.frequency +
                ", " + o.dataset.rate + "% a year (" + o.dataset.interest + ").";
        });
    })();
</script>